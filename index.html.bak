            {currentRoute === 'galeri' && (
              <div className="space-y-6 animate-fadeIn">
                <div className="bg-[#173D2B] rounded-3xl p-6 sm:p-10 text-[#F8F4EC] border-2 border-[#E9D8BD]/40 shadow-xl space-y-4">
                  <div className="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div>
                      <span className="text-xs uppercase font-bold tracking-widest text-[#E9D8BD]">Galeri & Katalog Produk</span>
                      <h2 className="font-serif text-3xl sm:text-4xl font-bold">SYAKIRA LEATHER COLLECTION</h2>
                      <p className="text-xs sm:text-sm text-[#F8F4EC]/80 max-w-2xl mt-1">
                        Koleksi lengkap jaket kulit domba asli dan sepatu kulit berkualitas ekspor khas pengrajin Sukaregang, Garut.
                      </p>
                    </div>
                    <a
                      href={SYAKIRA_OFFICIAL_SHOPEE_STORE}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="px-5 py-3 bg-[#8B4A2B] hover:bg-[#6E381F] text-white text-xs font-bold rounded-2xl transition shadow flex items-center space-x-2"
                    >
                      <Icon name="shopping-bag" className="w-4 h-4" />
                      <span>Official Shopee Store ↗</span>
                    </a>
                  </div>
                </div>

                {/* Filter Kategori */}
                <div className="flex flex-wrap gap-2">
                  {['Semua', 'Jaket Kulit Pria', 'Sepatu Pria', 'Sepatu Wanita'].map((cat) => (
                    <button
                      key={cat}
                      onClick={() => setStoreCategory(cat)}
                      className={`px-4 py-2 rounded-xl text-xs font-semibold transition ${
                        storeCategory === cat ? 'bg-[#173D2B] text-white shadow' : 'bg-white text-[#35251D] border border-[#E9D8BD]'
                      }`}
                    >
                      {cat}
                    </button>
                  ))}
                </div>

                {/* 20 Products Grid */}
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                  {filteredProducts.map((p) => {
                    const currentImg = customImages[p.id] || p.imageUrl;
                    return (
                      <div key={p.id} className="bg-white rounded-2xl overflow-hidden border border-[#E9D8BD]/50 shadow-md flex flex-col justify-between">
                        <div className="relative h-60 w-full bg-[#F8F4EC] overflow-hidden">
                          <img
                            src={currentImg}
                            alt={p.name}
                            referrerPolicy="no-referrer"
                            onError={(e) => {
                              e.target.onerror = null;
                              e.target.src = p.fallbackUrl || "https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&w=600&q=80";
                            }}
                            className="w-full h-full object-cover"
                          />
                          <span className="absolute top-2.5 left-2.5 bg-[#173D2B]/90 text-white text-[10px] px-2 py-0.5 rounded-full font-bold">
                            {p.category}
                          </span>
                        </div>
                        <div className="p-4 space-y-2">
                          <h4 className="font-serif font-bold text-sm text-[#173D2B] truncate">{p.name}</h4>
                          <span className="text-xs font-bold text-[#8B4A2B] block">{p.price || 'Rp 1.450.000'}</span>
                          <p className="text-[11px] text-gray-600 line-clamp-2">{p.description}</p>
                          <a
                            href={p.shopeeUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="w-full block py-2.5 bg-[#8B4A2B] hover:bg-[#6E381F] text-white font-bold text-xs rounded-xl text-center shadow transition"
                          >
                            Beli di Shopee Syakira ↗
                          </a>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {/* -------------------------------------------------------------
                KESAN & PESAN UNTUK SUKAREGANG (BUKU TAMU PENGUNJUNG)
            ------------------------------------------------------------- */}
            {currentRoute === 'reviews' && (
              <div className="space-y-8 animate-fadeIn">
                <div className="bg-[#173D2B] rounded-3xl p-6 sm:p-10 text-[#F8F4EC] border-2 border-[#E9D8BD]/40 shadow-xl space-y-3">
                  <span className="text-xs uppercase font-bold tracking-widest text-[#E9D8BD]">Buku Tamu Pengunjung</span>
                  <h2 className="font-serif text-3xl sm:text-4xl font-bold">KESAN & PESAN UNTUK SUKAREGANG</h2>
                  <p className="text-xs sm:text-sm text-[#F8F4EC]/85 max-w-2xl leading-relaxed">
                    Bagikan cerita dan ulasan kunjungan Anda saat berwisata atau belanja kerajinan kulit di Sukaregang, Garut!
                  </p>
                </div>

                <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
                  {/* Form Kirim */}
                  <div className="bg-white p-6 rounded-3xl border-2 border-[#E9D8BD]/50 shadow-md space-y-4">
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Tulis Kesan & Pesan</h3>
                    <form onSubmit={handleAddReview} className="space-y-3 text-xs">
                      <div>
                        <label className="font-bold block mb-1">Nama Lengkap:</label>
                        <input
                          type="text"
                          required
                          value={revName}
                          onChange={(e) => setRevName(e.target.value)}
                          placeholder="Nama Anda..."
                          className="w-full p-2.5 rounded-xl border border-[#E9D8BD]"
                        />
                      </div>
                      <div>
                        <label className="font-bold block mb-1">Kota Asal:</label>
                        <input
                          type="text"
                          value={revCity}
                          onChange={(e) => setRevCity(e.target.value)}
                          placeholder="Contoh: Bandung"
                          className="w-full p-2.5 rounded-xl border border-[#E9D8BD]"
                        />
                      </div>
                      <div>
                        <label className="font-bold block mb-1">Rating Pengalaman:</label>
                        <select
                          value={revRating}
                          onChange={(e) => setRevRating(e.target.value)}
                          className="w-full p-2.5 rounded-xl border border-[#E9D8BD] font-bold"
                        >
                          <option value="5">⭐⭐⭐⭐⭐ (5/5) Sangat Puas</option>
                          <option value="4">⭐⭐⭐⭐ (4/5) Puas</option>
                        </select>
                      </div>
                      <div>
                        <label className="font-bold block mb-1">Kesan & Pesan Anda:</label>
                        <textarea
                          rows="3"
                          required
                          value={revComment}
                          onChange={(e) => setRevComment(e.target.value)}
                          placeholder="Tuliskan pengalaman Anda..."
                          className="w-full p-2.5 rounded-xl border border-[#E9D8BD]"
                        ></textarea>
                      </div>
                      <button type="submit" className="w-full py-3 bg-[#173D2B] text-white font-bold rounded-xl shadow">
                        Kirim Kesan & Pesan
                      </button>
                    </form>
                  </div>

                  {/* Daftar Review */}
                  <div className="lg:col-span-2 space-y-3">
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Ulasan Wisatawan ({reviews.length})</h3>
                    <div className="space-y-3 max-h-[550px] overflow-y-auto custom-scroll pr-1">
                      {reviews.map((r) => (
                        <div key={r.id} className="p-4 bg-white rounded-2xl border border-[#E9D8BD] space-y-2 text-xs">
                          <div className="flex items-center justify-between">
                            <span className="font-bold text-[#173D2B]">{r.name} ({r.city})</span>
                            <span className="text-amber-500">{'⭐'.repeat(r.rating)}</span>
                          </div>
                          <p className="italic text-gray-700">"{r.comment}"</p>
                          <span className="text-[10px] text-gray-400 block">{r.date}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            )}

          </main>

          {/* =================================================================
              MODAL LOGIN SPLIT SCREEN (B. HALAMAN LOGIN)
          ================================================================= */}
          {isLoginModalOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-[#35251D]/85 backdrop-blur-md animate-fadeIn">
              <div className="bg-[#F8F4EC] rounded-3xl max-w-4xl w-full overflow-hidden shadow-2xl border-2 border-[#E9D8BD]/60 relative flex flex-col md:flex-row max-h-[92vh]">
                
                {/* Tombol Tutup */}
                <button
                  onClick={() => setIsLoginModalOpen(false)}
                  className="absolute top-4 right-4 z-20 w-8 h-8 rounded-full bg-[#173D2B]/80 hover:bg-[#8B4A2B] text-white flex items-center justify-center text-sm transition shadow"
                  title="Tutup Login"
                >
                  ✕
                </button>

                {/* SISI KIRI: VISUAL BRANDING */}
                <div className="md:w-1/2 relative bg-[#173D2B] text-[#F8F4EC] p-8 sm:p-10 flex flex-col justify-between overflow-hidden">
                  <div
                    className="absolute inset-0 bg-cover bg-center opacity-25 mix-blend-overlay"
                    style={{ backgroundImage: `url('https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&w=1000&q=80')` }}
                  ></div>
                  <div className="absolute inset-0 bg-gradient-to-b from-[#173D2B]/90 via-[#173D2B]/80 to-[#35251D]/90"></div>

                  <div className="relative z-10 space-y-6">
                    <div className="flex items-center space-x-3">
                      <img src="./logo.png" alt="Sukaregang Discovery" className="w-14 h-14 object-contain" />
                      <div>
                        <h4 className="font-serif font-bold text-lg tracking-wider text-[#F8F4EC]">SUKAREGANG</h4>
                        <span className="text-[10px] tracking-widest text-[#E9D8BD] font-bold uppercase block">Discovery • Garut</span>
                      </div>
                    </div>

                    <div className="space-y-3 pt-4">
                      <h2 className="font-serif text-2xl sm:text-3xl font-bold leading-snug">
                        Discover the Heritage, <br />
                        <span className="text-[#E9D8BD] italic font-normal">Explore the Leather.</span>
                      </h2>
                      <p className="text-xs text-[#F8F4EC]/85 leading-relaxed">
                        "Jelajahi keunikan Sukaregang, kenali warisan kerajinan kulit Garut, dan temukan pengalaman wisata yang berbeda."
                      </p>
                    </div>
                  </div>

                  <div className="relative z-10 pt-6 mt-6 border-t border-[#E9D8BD]/20 text-[11px] text-[#E9D8BD]/80">
                    Mitra Resmi: <strong>Syakira Leather Sukaregang</strong>
                  </div>
                </div>

                {/* SISI KANAN: FORM LOGIN */}
                <div className="md:w-1/2 p-8 sm:p-10 flex flex-col justify-between bg-white overflow-y-auto custom-scroll">
                  <div className="space-y-5">
                    <div>
                      <h3 className="font-serif text-2xl sm:text-3xl font-bold text-[#173D2B]">Selamat Datang Kembali!</h3>
                      <p className="text-xs text-[#35251D]/75 mt-1">Masuk dan mulai perjalanan eksplorasimu bersama Sukaregang Discovery.</p>
                    </div>

                    {loginToast && (
                      <div className="p-3 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold animate-fadeIn">
                        ✓ {loginToast}
                      </div>
                    )}
                    {loginError && (
                      <div className="p-3 rounded-xl bg-red-50 border border-red-300 text-red-700 text-xs font-bold animate-fadeIn">
                        ⚠️ {loginError}
                      </div>
                    )}

                    <form onSubmit={handleLoginSubmit} className="space-y-3.5 text-xs">
                      <div>
                        <label className="font-bold text-[#173D2B] block mb-1">Email atau Username:</label>
                        <input
                          type="text"
                          required
                          value={loginIdentifier}
                          onChange={(e) => setLoginIdentifier(e.target.value)}
                          placeholder="nama@email.com atau username"
                          className="w-full p-2.5 rounded-xl border border-[#E9D8BD] bg-[#F8F4EC]/40"
                        />
                      </div>

                      <div>
                        <label className="font-bold text-[#173D2B] block mb-1">Kata Sandi (Password):</label>
                        <div className="relative">
                          <input
                            type={showPassword ? 'text' : 'password'}
                            required
                            value={loginPassword}
                            onChange={(e) => setLoginPassword(e.target.value)}
                            placeholder="Kata sandi..."
                            className="w-full p-2.5 pr-10 rounded-xl border border-[#E9D8BD] bg-[#F8F4EC]/40"
                          />
                          <button
                            type="button"
                            onClick={() => setShowPassword(!showPassword)}
                            className="absolute right-3 top-2.5 text-gray-400"
                          >
                            <Icon name={showPassword ? 'eye-off' : 'eye'} className="w-4 h-4" />
                          </button>
                        </div>
                      </div>

                      <div className="flex items-center justify-between pt-1">
                        <label className="flex items-center space-x-2 cursor-pointer">
                          <input
                            type="checkbox"
                            checked={rememberMe}
                            onChange={(e) => setRememberMe(e.target.checked)}
                            className="rounded text-[#173D2B]"
                          />
                          <span>Ingat Saya</span>
                        </label>
                        <button type="button" onClick={() => alert('Hubungi admin jika Anda lupa password.')} className="text-[#8B4A2B] hover:underline font-semibold">
                          Lupa Password?
                        </button>
                      </div>

                      <button
                        type="submit"
                        disabled={loginLoading}
                        className="w-full py-3.5 bg-[#173D2B] hover:bg-[#102B1E] text-white font-bold rounded-xl shadow-lg transition"
                      >
                        {loginLoading ? 'Memproses Masuk...' : 'Masuk Sekarang →'}
                      </button>
                    </form>

                    {/* Quick Demo Login */}
                    <div className="pt-2 border-t border-[#ECE3D4] text-center space-y-2">
                      <span className="text-[10px] text-gray-400 uppercase font-bold block">Akses Cepat Pengujian:</span>
                      <div className="grid grid-cols-2 gap-2 text-xs">
                        <button
                          type="button"
                          onClick={() => handleQuickDemoLogin('admin')}
                          className="py-2 px-3 bg-[#F8F4EC] text-[#173D2B] font-bold rounded-xl border border-[#E9D8BD]"
                        >
                          👑 Demo Admin
                        </button>
                        <button
                          type="button"
                          onClick={() => handleQuickDemoLogin('member')}
                          className="py-2 px-3 bg-[#F8F4EC] text-[#173D2B] font-bold rounded-xl border border-[#E9D8BD]"
                        >
                          👤 Demo Wisatawan
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          )}

          {/* =================================================================
              MODAL PROFIL WISATAWAN
          ================================================================= */}
          {isProfileModalOpen && currentUser && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#35251D]/80 backdrop-blur-sm animate-fadeIn">
              <div className="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border-2 border-[#E9D8BD]/40 p-6 space-y-4">
                <div className="flex items-center justify-between border-b pb-3">
                  <h3 className="font-serif text-lg font-bold text-[#173D2B]">Profil Akun</h3>
                  <button onClick={() => setIsProfileModalOpen(false)} className="text-gray-400 hover:text-black">✕</button>
                </div>
                <div className="flex items-center space-x-3">
                  <img src="./logo.png" alt="Avatar" className="w-14 h-14 object-contain border p-1 rounded-2xl bg-[#173D2B]" />
                  <div>
                    <h4 className="font-bold text-sm text-[#173D2B]">{currentUser.name}</h4>
                    <span className="text-xs text-gray-500">{currentUser.email}</span>
                    <span className="text-[10px] text-emerald-700 block font-bold mt-0.5">Role: {currentUser.role}</span>
                  </div>
                </div>
                {currentUser.role === 'admin' && (
                  <button
                    onClick={() => {
                      setIsProfileModalOpen(false);
                      setCurrentRoute('admin_dashboard');
                    }}
                    className="w-full py-2.5 bg-[#173D2B] text-white font-bold text-xs rounded-xl shadow"
                  >
                    Buka Dashboard Admin Full Screen →
                  </button>
                )}
                <button
                  onClick={handleLogout}
                  className="w-full py-2.5 bg-red-50 text-red-600 font-bold text-xs rounded-xl hover:bg-red-100"
                >
                  Keluar Akun (Logout)
                </button>
              </div>
            </div>
          )}

          {/* FOOTER USER VIEW */}
          <footer className="bg-[#102B1E] text-[#F8F4EC] py-8 border-t border-[#E9D8BD]/30 mt-12">
            <div className="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left text-xs text-[#F8F4EC]/70">
              <div className="flex items-center space-x-3">
                <img src="./logo.png" alt="Logo" className="w-8 h-8 object-contain" />
                <div>
                  <p className="font-serif font-bold text-sm text-[#F8F4EC]">SUKAREGANG DISCOVERY</p>
                  <p className="text-[10px] text-[#E9D8BD]">Garut Sentra Kerajinan Kulit Indonesia</p>
                </div>
              </div>
              <div className="flex items-center space-x-4">
                <button onClick={() => setCurrentRoute('simulator')} className="hover:text-[#E9D8BD] underline">Game 3D</button>
                <span>•</span>
                <button onClick={() => setCurrentRoute('galeri')} className="hover:text-[#E9D8BD] underline">Syakira Store</button>
                <span>•</span>
                <button onClick={() => setCurrentRoute('admin_dashboard')} className="hover:text-[#E9D8BD] underline">Portal Admin</button>
              </div>
              <p className="text-[11px]">&copy; 2026 Sukaregang Discovery & Syakira Leather. All rights reserved.</p>
            </div>
          </footer>

        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
