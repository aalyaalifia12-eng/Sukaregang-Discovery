    // Icon helper component
    function Icon({ name, className = "w-5 h-5" }) {
      useEffect(() => {
        if (window.lucide) {
          window.lucide.createIcons();
        }
      }, [name]);
      return <i data-lucide={name} className={className}></i>;
    }

    // =========================================================================
    // 2. THREE.JS 3D CANVAS COMPONENT (REAL TIME HIGH-FIDELITY 3D LEATHER VIEWER)
    // =========================================================================
    function ThreeLeatherViewer({ craftType = 'jaket', color = '#1a1a1a', modelType = 'Biker' }) {
      const mountRef = useRef(null);
      const [isAutoSpin, setIsAutoSpin] = useState(true);
      const [currentColor, setCurrentColor] = useState(color);
      const [cameraDist, setCameraDist] = useState(5.2);
      const [hasWebGLError, setHasWebGLError] = useState(false);
      const [fallbackAngle, setFallbackAngle] = useState(25);

      // Keep internal color in sync with prop
      useEffect(() => {
        setCurrentColor(color);
      }, [color]);

      useEffect(() => {
        if (!mountRef.current) return;
        if (typeof THREE === 'undefined') {
          setHasWebGLError(true);
          return;
        }

        let container = mountRef.current;
        let width = container.clientWidth || 360;
        let height = container.clientHeight || 300;

        // Scene, Camera, WebGLRenderer
        let scene, camera, renderer;
        try {
          scene = new THREE.Scene();
          scene.background = new THREE.Color(0xF8F4EC);

          camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 100);
          camera.position.set(0, 0.4, cameraDist);

          renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
          renderer.setSize(width, height);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          renderer.shadowMap.enabled = true;
          renderer.shadowMap.type = THREE.PCFSoftShadowMap;

          container.innerHTML = '';
          container.appendChild(renderer.domElement);
        } catch (e) {
          setHasWebGLError(true);
          return;
        }

        // 3-Point Studio Lighting for authentic leather specular highlights
        const ambientLight = new THREE.AmbientLight(0xfff8ee, 0.85);
        scene.add(ambientLight);

        // Key Light (Warm Sun / Studio Spot)
        const keyLight = new THREE.DirectionalLight(0xfffaed, 1.1);
        keyLight.position.set(4, 5, 5);
        keyLight.castShadow = true;
        scene.add(keyLight);

        // Fill Light (Soft cool fill)
        const fillLight = new THREE.DirectionalLight(0xdbe7e4, 0.6);
        fillLight.position.set(-4, 2, 3);
        scene.add(fillLight);

        // Back Rim Light (Gives rich edge sheen on leather shoulders & curves)
        const rimLight = new THREE.DirectionalLight(0xe9d8bd, 0.85);
        rimLight.position.set(0, 4, -4);
        scene.add(rimLight);

        // Leather Color Parsing
        let hexColor = 0x181818; // Default Black
        const colStr = String(currentColor).toLowerCase();
        if (colStr.includes('cokelat') || colStr.includes('brown')) hexColor = 0x4a240c;
        else if (colStr.includes('tan') || colStr.includes('cognac')) hexColor = 0x945428;
        else if (colStr.includes('marun') || colStr.includes('red') || colStr.includes('maroon')) hexColor = 0x4a1212;
        else if (colStr.startsWith('#')) hexColor = parseInt(colStr.replace('#', '0x'), 16);

        // PBR Materials
        const leatherMat = new THREE.MeshStandardMaterial({
          color: hexColor,
          roughness: 0.32,
          metalness: 0.16,
          bumpScale: 0.04
        });

        const accentLeatherMat = new THREE.MeshStandardMaterial({
          color: hexColor,
          roughness: 0.25,
          metalness: 0.2
        });

        const brassMetalMat = new THREE.MeshStandardMaterial({
          color: 0xd4af37, // Golden brass YKK hardware
          metalness: 0.9,
          roughness: 0.22
        });

        const chromeMetalMat = new THREE.MeshStandardMaterial({
          color: 0xcccccc,
          metalness: 0.92,
          roughness: 0.18
        });

        const soleRubberMat = new THREE.MeshStandardMaterial({
          color: 0x151515,
          roughness: 0.85,
          metalness: 0.05
        });

        const woodPedestalMat = new THREE.MeshStandardMaterial({
          color: 0xd6c2a5,
          roughness: 0.6
        });

        // Main 3D Model Root Group
        const rootGroup = new THREE.Group();

        // Studio Showroom Turntable Pedestal
        const pedestalGeo = new THREE.CylinderGeometry(2.1, 2.2, 0.12, 36);
        const pedestalMesh = new THREE.Mesh(pedestalGeo, woodPedestalMat);
        pedestalMesh.position.set(0, -1.35, 0);
        pedestalMesh.receiveShadow = true;
        rootGroup.add(pedestalMesh);

        // Subtle Pedestal Rim Ring
        const ringGeo = new THREE.TorusGeometry(2.12, 0.03, 8, 36);
        const ringMesh = new THREE.Mesh(ringGeo, brassMetalMat);
        ringMesh.rotation.x = Math.PI / 2;
        ringMesh.position.set(0, -1.29, 0);
        rootGroup.add(ringMesh);

        if (craftType === 'jaket') {
          // =================================================================
          // HIGH-FIDELITY 3D LEATHER JACKET MODEL
          // =================================================================
          const jacketGroup = new THREE.Group();

          // 1. Torso Body (Tapered Chest to Waist)
          const torsoGeo = new THREE.CylinderGeometry(0.88, 0.76, 1.85, 24);
          const torsoMesh = new THREE.Mesh(torsoGeo, leatherMat);
          torsoMesh.castShadow = true;
          jacketGroup.add(torsoMesh);

          // 2. Waistband Hem (Ribbed leather waist rim)
          const waistGeo = new THREE.CylinderGeometry(0.78, 0.8, 0.22, 24);
          const waistMesh = new THREE.Mesh(waistGeo, accentLeatherMat);
          waistMesh.position.set(0, -0.95, 0);
          jacketGroup.add(waistMesh);

          // 3. Wide Biker Lapels (Folded chest collar)
          const lapelLGeo = new THREE.BoxGeometry(0.44, 0.72, 0.06);
          const lapelL = new THREE.Mesh(lapelLGeo, accentLeatherMat);
          lapelL.position.set(-0.34, 0.52, 0.82);
          lapelL.rotation.set(0.1, 0.15, -0.22);
          jacketGroup.add(lapelL);

          const lapelRGeo = new THREE.BoxGeometry(0.44, 0.72, 0.06);
          const lapelR = new THREE.Mesh(lapelRGeo, accentLeatherMat);
          lapelR.position.set(0.34, 0.52, 0.82);
          lapelR.rotation.set(0.1, -0.15, 0.22);
          jacketGroup.add(lapelR);

          // 4. Lapel Corner Metal Snaps (Brass Studs)
          [-0.46, -0.24, 0.24, 0.46].forEach((x, i) => {
            const snapGeo = new THREE.CylinderGeometry(0.04, 0.04, 0.04, 12);
            const snapMesh = new THREE.Mesh(snapGeo, brassMetalMat);
            snapMesh.rotation.x = Math.PI / 2;
            snapMesh.position.set(x, 0.72 - (i % 2) * 0.35, 0.88);
            jacketGroup.add(snapMesh);
          });

          // 5. Asymmetrical Heavy Duty Zipper Rail
          const zipRailGeo = new THREE.BoxGeometry(0.06, 1.8, 0.08);
          const zipRail = new THREE.Mesh(zipRailGeo, brassMetalMat);
          zipRail.position.set(0.12, 0, 0.84);
          zipRail.rotation.z = -0.05;
          jacketGroup.add(zipRail);

          // Zipper Slider & Pull-Tab
          const zipPullGeo = new THREE.BoxGeometry(0.06, 0.18, 0.02);
          const zipPull = new THREE.Mesh(zipPullGeo, brassMetalMat);
          zipPull.position.set(0.12, 0.35, 0.9);
          jacketGroup.add(zipPull);

          // 6. Chest Welt Pockets with Zipper Tracks
          const pocket1Geo = new THREE.BoxGeometry(0.38, 0.05, 0.04);
          const pocket1 = new THREE.Mesh(pocket1Geo, brassMetalMat);
          pocket1.position.set(-0.42, 0.18, 0.82);
          pocket1.rotation.z = 0.25;
          jacketGroup.add(pocket1);

          const pocket2Geo = new THREE.BoxGeometry(0.38, 0.05, 0.04);
          const pocket2 = new THREE.Mesh(pocket2Geo, brassMetalMat);
          pocket2.position.set(0.42, -0.32, 0.78);
          pocket2.rotation.z = -0.1;
          jacketGroup.add(pocket2);

          // 7. Shoulder Epaulettes (Lidah Bahu Berpaku)
          [-0.65, 0.65].forEach((x, i) => {
            const epauGeo = new THREE.BoxGeometry(0.36, 0.04, 0.14);
            const epauMesh = new THREE.Mesh(epauGeo, accentLeatherMat);
            epauMesh.position.set(x, 0.92, 0);
            epauMesh.rotation.z = (i === 0 ? 1 : -1) * 0.18;
            jacketGroup.add(epauMesh);

            const studGeo = new THREE.CylinderGeometry(0.035, 0.035, 0.03, 10);
            const studMesh = new THREE.Mesh(studGeo, brassMetalMat);
            studMesh.position.set(x * 0.85, 0.95, 0);
            jacketGroup.add(studMesh);
          });

          // 8. Articulated Left Sleeve (Upper Arm & Forearm)
          const sleeveLGroup = new THREE.Group();
          const upperArmL = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.24, 0.95, 16), leatherMat);
          upperArmL.position.set(0, -0.4, 0);
          sleeveLGroup.add(upperArmL);

          const foreArmL = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.2, 0.95, 16), leatherMat);
          foreArmL.position.set(0.08, -1.2, 0.12);
          foreArmL.rotation.z = 0.15;
          sleeveLGroup.add(foreArmL);

          // Wrist Cuff Zipper Left
          const cuffZipL = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.25, 0.03), brassMetalMat);
          cuffZipL.position.set(0.12, -1.6, 0.22);
          sleeveLGroup.add(cuffZipL);

          sleeveLGroup.position.set(-1.12, 0.75, 0);
          sleeveLGroup.rotation.z = 0.26;
          jacketGroup.add(sleeveLGroup);

          // 9. Articulated Right Sleeve
          const sleeveRGroup = new THREE.Group();
          const upperArmR = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.24, 0.95, 16), leatherMat);
          upperArmR.position.set(0, -0.4, 0);
          sleeveRGroup.add(upperArmR);

          const foreArmR = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.2, 0.95, 16), leatherMat);
          foreArmR.position.set(-0.08, -1.2, 0.12);
          foreArmR.rotation.z = -0.15;
          sleeveRGroup.add(foreArmR);

          // Wrist Cuff Zipper Right
          const cuffZipR = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.25, 0.03), brassMetalMat);
          cuffZipR.position.set(-0.12, -1.6, 0.22);
          sleeveRGroup.add(cuffZipR);

          sleeveRGroup.position.set(1.12, 0.75, 0);
          sleeveRGroup.rotation.z = -0.26;
          jacketGroup.add(sleeveRGroup);

          // 10. Waist Leather Belt with Metal Buckle
          const beltGeo = new THREE.TorusGeometry(0.82, 0.045, 8, 32);
          const beltMesh = new THREE.Mesh(beltGeo, accentLeatherMat);
          beltMesh.rotation.x = Math.PI / 2;
          beltMesh.position.set(0, -0.88, 0);
          jacketGroup.add(beltMesh);

          // Belt Buckle
          const buckleGeo = new THREE.TorusGeometry(0.11, 0.025, 4, 4);
          const buckleMesh = new THREE.Mesh(buckleGeo, chromeMetalMat);
          buckleMesh.position.set(0, -0.88, 0.88);
          jacketGroup.add(buckleMesh);

          jacketGroup.position.set(0, 0.1, 0);
          rootGroup.add(jacketGroup);

        } else {
          // =================================================================
          // HIGH-FIDELITY 3D LEATHER SHOE MODEL (GARUT CRAFTED)
          // =================================================================
          const shoeGroup = new THREE.Group();

          // 1. Lug Outsole with Tread Cleats
          const soleGeo = new THREE.BoxGeometry(1.3, 0.22, 2.7);
          const soleMesh = new THREE.Mesh(soleGeo, soleRubberMat);
          soleMesh.position.set(0, -0.9, 0.1);
          soleMesh.castShadow = true;
          shoeGroup.add(soleMesh);

          // Stacked Leather Heel
          const heelGeo = new THREE.BoxGeometry(1.24, 0.25, 0.95);
          const heelMesh = new THREE.Mesh(heelGeo, soleRubberMat);
          heelMesh.position.set(0, -0.72, -0.75);
          shoeGroup.add(heelMesh);

          // 2. Goodyear Welt Perimeter Rim (Contrasting leather stitch line)
          const weltGeo = new THREE.BoxGeometry(1.36, 0.06, 2.76);
          const weltMesh = new THREE.Mesh(weltGeo, accentLeatherMat);
          weltMesh.position.set(0, -0.77, 0.1);
          shoeGroup.add(weltMesh);

          // 3. Front Vamp & Cap Toe (Anatomically shaped foot)
          const vampGeo = new THREE.CylinderGeometry(0.56, 0.65, 0.65, 20);
          const vampMesh = new THREE.Mesh(vampGeo, leatherMat);
          vampMesh.position.set(0, -0.42, 0.65);
          vampMesh.scale.set(1.05, 0.85, 1.45);
          shoeGroup.add(vampMesh);

          // Cap Toe Stitch Line
          const capToeGeo = new THREE.TorusGeometry(0.58, 0.025, 8, 20, Math.PI);
          const capToeMesh = new THREE.Mesh(capToeGeo, brassMetalMat);
          capToeMesh.rotation.x = Math.PI / 2;
          capToeMesh.position.set(0, -0.38, 1.15);
          shoeGroup.add(capToeMesh);

          // 4. Ankle Collar & Quarter Panels
          const ankleGeo = new THREE.CylinderGeometry(0.52, 0.58, 1.15, 20);
          const ankleMesh = new THREE.Mesh(ankleGeo, leatherMat);
          ankleMesh.position.set(0, -0.15, -0.35);
          shoeGroup.add(ankleMesh);

          // Padded Top Rim Collar
          const topRimGeo = new THREE.TorusGeometry(0.54, 0.07, 8, 24);
          const topRimMesh = new THREE.Mesh(topRimGeo, accentLeatherMat);
          topRimMesh.rotation.x = Math.PI / 2;
          topRimMesh.position.set(0, 0.42, -0.35);
          shoeGroup.add(topRimMesh);

          // 5. Padded Leather Tongue
          const tongueGeo = new THREE.BoxGeometry(0.48, 0.85, 0.08);
          const tongueMesh = new THREE.Mesh(tongueGeo, accentLeatherMat);
          tongueMesh.position.set(0, 0.08, 0.15);
          tongueMesh.rotation.x = -0.42;
          shoeGroup.add(tongueMesh);

          // 6. Shiny Brass Eyelets (6 pairs along the throat)
          [-0.24, 0.24].forEach((x) => {
            [0.35, 0.18, 0.01, -0.16].forEach((y, i) => {
              const eyeletGeo = new THREE.TorusGeometry(0.035, 0.015, 6, 12);
              const eyeletMesh = new THREE.Mesh(eyeletGeo, brassMetalMat);
              eyeletMesh.position.set(x, y, 0.25 + i * 0.12);
              eyeletMesh.rotation.y = Math.PI / 2;
              shoeGroup.add(eyeletMesh);
            });
          });

          // 7. 3D Shoelaces (Cross-laced cords)
          [0.32, 0.15, -0.02].forEach((y, i) => {
            const laceGeo = new THREE.CylinderGeometry(0.02, 0.02, 0.46, 8);
            const laceMesh = new THREE.Mesh(laceGeo, chromeMetalMat);
            laceMesh.rotation.z = Math.PI / 2;
            laceMesh.position.set(0, y, 0.28 + i * 0.12);
            shoeGroup.add(laceMesh);
          });

          // Shoelace Knot Bow on Top
          const knotGeo = new THREE.TorusGeometry(0.09, 0.025, 6, 12);
          const knotMesh = new THREE.Mesh(knotGeo, chromeMetalMat);
          knotMesh.position.set(0, 0.42, 0.22);
          shoeGroup.add(knotMesh);

          shoeGroup.position.set(0, -0.1, 0);
          rootGroup.add(shoeGroup);
        }

        scene.add(rootGroup);

        // Smooth Mouse/Touch Drag Controls with Inertia Damping
        let isDragging = false;
        let previousMousePosition = { x: 0, y: 0 };
        let rotationVelocity = { x: 0, y: 0 };

        const onPointerDown = (e) => {
          isDragging = true;
          const clientX = e.clientX || (e.touches && e.touches[0].clientX) || 0;
          const clientY = e.clientY || (e.touches && e.touches[0].clientY) || 0;
          previousMousePosition = { x: clientX, y: clientY };
          rotationVelocity = { x: 0, y: 0 };
        };

        const onPointerMove = (e) => {
          if (!isDragging) return;
          const clientX = e.clientX || (e.touches && e.touches[0].clientX) || 0;
          const clientY = e.clientY || (e.touches && e.touches[0].clientY) || 0;

          const deltaX = clientX - previousMousePosition.x;
          const deltaY = clientY - previousMousePosition.y;

          rootGroup.rotation.y += deltaX * 0.012;
          rootGroup.rotation.x = Math.max(-0.6, Math.min(0.6, rootGroup.rotation.x + deltaY * 0.008));

          rotationVelocity = { x: deltaX * 0.01, y: deltaY * 0.006 };
          previousMousePosition = { x: clientX, y: clientY };
        };

        const onPointerUp = () => {
          isDragging = false;
        };

        const domElem = renderer.domElement;
        domElem.addEventListener('mousedown', onPointerDown);
        window.addEventListener('mousemove', onPointerMove);
        window.addEventListener('mouseup', onPointerUp);

        domElem.addEventListener('touchstart', onPointerDown, { passive: true });
        window.addEventListener('touchmove', onPointerMove, { passive: true });
        window.addEventListener('touchend', onPointerUp);

        // Animation Loop
        let animationFrameId;
        const animate = () => {
          animationFrameId = requestAnimationFrame(animate);

          if (!isDragging) {
            // Apply gentle inertia
            rootGroup.rotation.y += rotationVelocity.x;
            rootGroup.rotation.x += rotationVelocity.y;
            rotationVelocity.x *= 0.92;
            rotationVelocity.y *= 0.92;

            if (isAutoSpin && Math.abs(rotationVelocity.x) < 0.002) {
              rootGroup.rotation.y += 0.008; // Continuous smooth rotation
            }
          }

          renderer.render(scene, camera);
        };
        animate();

        // Responsive Resize
        const handleResize = () => {
          if (!container) return;
          const w = container.clientWidth || 360;
          const h = container.clientHeight || 300;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        };
        window.addEventListener('resize', handleResize);

        // Cleanup
        return () => {
          cancelAnimationFrame(animationFrameId);
          window.removeEventListener('resize', handleResize);
          domElem.removeEventListener('mousedown', onPointerDown);
          window.removeEventListener('mousemove', onPointerMove);
          window.removeEventListener('mouseup', onPointerUp);
          domElem.removeEventListener('touchstart', onPointerDown);
          window.removeEventListener('touchmove', onPointerMove);
          window.removeEventListener('touchend', onPointerUp);
          if (container) container.innerHTML = '';
        };
      }, [craftType, currentColor, modelType, isAutoSpin, cameraDist]);

      return (
        <div className="relative w-full h-full min-h-[300px] flex items-center justify-center bg-gradient-to-b from-[#F8F4EC] to-[#E9D8BD]/50 rounded-3xl overflow-hidden border-2 border-[#E9D8BD] shadow-inner select-none group">
          {/* Main 3D Canvas Mount Point */}
          {!hasWebGLError ? (
            <div ref={mountRef} className="w-full h-full cursor-grab active:cursor-grabbing"></div>
          ) : (
            /* Fallback 360 Turntable Vector Studio */
            <div
              className="w-full h-full flex flex-col items-center justify-center p-6 text-center cursor-grab"
              onMouseDown={(e) => {
                const startX = e.clientX;
                const onMove = (ev) => {
                  setFallbackAngle((prev) => (prev + (ev.clientX - startX) * 0.2) % 360);
                };
                const onUp = () => {
                  window.removeEventListener('mousemove', onMove);
                  window.removeEventListener('mouseup', onUp);
                };
                window.addEventListener('mousemove', onMove);
                window.addEventListener('mouseup', onUp);
              }}
            >
              <div
                className="w-48 h-48 rounded-full border-4 border-[#8B4A2B] bg-[#173D2B] text-white flex items-center justify-center shadow-2xl transition transform duration-75"
                style={{ transform: `rotateY(${fallbackAngle}deg)` }}
              >
                <div className="text-center space-y-1">
                  <span className="text-6xl block">{craftType === 'jaket' ? '🧥' : '👞'}</span>
                  <span className="font-serif font-bold text-xs text-[#E9D8BD] block">
                    {craftType === 'jaket' ? 'Jaket Kulit 3D' : 'Sepatu Kulit 3D'}
                  </span>
                  <span className="text-[10px] text-gray-300">Warna: {currentColor}</span>
                </div>
              </div>
              <p className="text-[11px] text-[#35251D]/75 font-semibold mt-3">
                Geser ke kiri / kanan untuk memutar 360°
              </p>
            </div>
          )}

          {/* Interactive Floating 3D Controls Bar */}
          <div className="absolute top-3 left-3 flex items-center space-x-1.5 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-full text-[#F8F4EC] text-[10px] font-bold border border-white/20 shadow-lg">
            <span className="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>3D Studio • {craftType === 'jaket' ? 'Jaket Garut' : 'Sepatu Garut'}</span>
          </div>

          {/* Floating Controls at Top Right */}
          <div className="absolute top-3 right-3 flex items-center space-x-1">
            <button
              type="button"
              onClick={() => setIsAutoSpin(!isAutoSpin)}
              className={`p-2 rounded-xl backdrop-blur-md border text-xs transition shadow ${
                isAutoSpin ? 'bg-[#173D2B] text-[#E9D8BD] border-[#E9D8BD]' : 'bg-black/60 text-white border-white/20'
              }`}
              title={isAutoSpin ? 'Jeda Putaran Otomatis' : 'Mulai Putar Otomatis'}
            >
              {isAutoSpin ? '⏸️' : '▶️'}
            </button>
            <button
              type="button"
              onClick={() => setCameraDist((prev) => Math.max(3.8, prev - 0.4))}
              className="p-2 rounded-xl bg-black/60 hover:bg-black/80 text-white border border-white/20 text-xs backdrop-blur-md shadow"
              title="Perbesar (Zoom In)"
            >
              🔍+
            </button>
            <button
              type="button"
              onClick={() => setCameraDist((prev) => Math.min(6.8, prev + 0.4))}
              className="p-2 rounded-xl bg-black/60 hover:bg-black/80 text-white border border-white/20 text-xs backdrop-blur-md shadow"
              title="Perkecil (Zoom Out)"
            >
              🔍-
            </button>
          </div>

          {/* Bottom Floating Interactive Bar */}
          <div className="absolute bottom-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 pointer-events-none">
            {/* Direct Color Selector Pills */}
            <div className="flex items-center space-x-1.5 bg-black/70 backdrop-blur-md px-2.5 py-1.5 rounded-full pointer-events-auto border border-white/20 shadow-lg">
              <span className="text-[9px] text-[#E9D8BD] font-bold mr-1">Warna:</span>
              {[
                { name: 'Hitam', hex: '#181818', bg: 'bg-black' },
                { name: 'Cokelat', hex: '#4a240c', bg: 'bg-[#4a240c]' },
                { name: 'Tan', hex: '#945428', bg: 'bg-[#945428]' },
                { name: 'Maroon', hex: '#4a1212', bg: 'bg-[#4a1212]' },
              ].map((c) => (
                <button
                  key={c.name}
                  type="button"
                  onClick={() => setCurrentColor(c.name)}
                  className={`w-5 h-5 rounded-full ${c.bg} border-2 transition transform hover:scale-110 ${
                    currentColor.toLowerCase().includes(c.name.toLowerCase()) ? 'border-white scale-110 ring-2 ring-[#E9D8BD]' : 'border-gray-500'
                  }`}
                  title={`Ubah warna 3D ke ${c.name}`}
                ></button>
              ))}
            </div>

            {/* Hint Badge */}
            <div className="bg-black/70 backdrop-blur-md text-[#F8F4EC] text-[9px] px-3 py-1.5 rounded-full font-bold border border-white/20 shadow flex items-center space-x-1.5">
              <span>🔄</span>
              <span>Geser untuk memutar 360°</span>
            </div>
          </div>
        </div>
      );
    }

    // =========================================================================
    // 2B. HALAMAN LOGIN SEDERHANA (HANYA LOGIN, SUDAH/BELUM PUNYA AKUN, PORTAL ADMIN)
    // =========================================================================
    function LoginPage({
      currentUser,
      onBack,
      onGoToAdmin,
      loginIdentifier,
      setLoginIdentifier,
      loginPassword,
      setLoginPassword,
      showPassword,
      setShowPassword,
      rememberMe,
      setRememberMe,
      loginLoading,
      loginError,
      loginToast,
      handleLoginSubmit,
      handleQuickDemoLogin,
    }) {
      const [isRegisterMode, setIsRegisterMode] = useState(false);

      return (
        <div className="min-h-screen bg-[#F8F4EC] flex flex-col justify-center items-center p-4 sm:p-6 antialiased font-sans">
          {/* Tombol Kembali ke Beranda di Atas */}
          <div className="w-full max-w-md flex items-center justify-between mb-5">
            <button
              type="button"
              onClick={onBack}
              className="flex items-center space-x-2 text-xs font-bold text-[#173D2B] hover:text-[#8B4A2B] transition group"
            >
              <span className="w-8 h-8 rounded-full bg-white border border-[#E9D8BD] flex items-center justify-center shadow-sm group-hover:scale-105 transition">
                ←
              </span>
              <span>Kembali ke Beranda</span>
            </button>
            <div className="flex items-center space-x-2">
              <img src="./logo.png" alt="Logo" className="w-7 h-7 object-contain" />
              <span className="text-xs font-serif font-bold text-[#173D2B]">Sukaregang Discovery</span>
            </div>
          </div>

          {/* Card Form Login Sederhana */}
          <div className="bg-white rounded-3xl max-w-md w-full p-8 sm:p-10 border-2 border-[#E9D8BD]/80 shadow-2xl space-y-6">
            {/* Header Form */}
            <div className="text-center space-y-2">
              <div className="w-16 h-16 mx-auto rounded-2xl bg-[#173D2B] flex items-center justify-center p-2.5 shadow-md border border-[#E9D8BD]/40">
                <img src="./logo.png" alt="Logo" className="w-full h-full object-contain" />
              </div>
              <h2 className="font-serif text-2xl sm:text-3xl font-bold text-[#173D2B]">
                {isRegisterMode ? 'Daftar Akun' : 'Log In'}
              </h2>
              <p className="text-xs text-[#35251D]/70">
                {isRegisterMode
                  ? 'Buat akun untuk mulai eksplorasi sentra kulit Garut'
                  : 'Masuk dan mulai perjalanan eksplorasimu bersama Sukaregang Discovery'}
              </p>
            </div>

            {/* Notifikasi Toast / Error */}
            {loginToast && (
              <div className="p-3 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold animate-fadeIn text-center">
                ✓ {loginToast}
              </div>
            )}
            {loginError && (
              <div className="p-3 rounded-xl bg-red-50 border border-red-300 text-red-700 text-xs font-bold animate-fadeIn text-center">
                ⚠️ {loginError}
              </div>
            )}

            {/* Form Input Sederhana */}
            <form onSubmit={handleLoginSubmit} className="space-y-4 text-xs">
              <div>
                <label className="font-bold text-[#173D2B] block mb-1.5">
                  Email atau Username:
                </label>
                <input
                  type="text"
                  required
                  value={loginIdentifier}
                  onChange={(e) => setLoginIdentifier(e.target.value)}
                  placeholder="nama@email.com atau username"
                  className="w-full p-3 rounded-xl border border-[#E9D8BD] bg-[#F8F4EC]/40 text-xs focus:outline-none focus:border-[#173D2B] focus:ring-2 focus:ring-[#173D2B]/20"
                />
              </div>

              <div>
                <label className="font-bold text-[#173D2B] block mb-1.5">
                  Kata Sandi:
                </label>
                <div className="relative">
                  <input
                    type={showPassword ? 'text' : 'password'}
                    required
                    value={loginPassword}
                    onChange={(e) => setLoginPassword(e.target.value)}
                    placeholder="Masukkan kata sandi..."
                    className="w-full p-3 pr-10 rounded-xl border border-[#E9D8BD] bg-[#F8F4EC]/40 text-xs focus:outline-none focus:border-[#173D2B] focus:ring-2 focus:ring-[#173D2B]/20"
                  />
                  <button
                    type="button"
                    onClick={() => setShowPassword(!showPassword)}
                    className="absolute right-3 top-3 text-gray-400 hover:text-[#173D2B]"
                  >
                    <Icon name={showPassword ? 'eye-off' : 'eye'} className="w-4 h-4" />
                  </button>
                </div>
              </div>

              <button
                type="submit"
                disabled={loginLoading}
                className="w-full py-3.5 bg-[#173D2B] hover:bg-[#102B1E] disabled:bg-gray-400 text-white font-bold text-xs rounded-xl shadow-lg transition"
              >
                {loginLoading
                  ? 'Memproses...'
                  : isRegisterMode
                  ? 'Daftar Sekarang'
                  : 'Log In'}
              </button>
            </form>

            {/* Sudah punya akun / Belum punya akun */}
            <div className="text-center pt-2 border-t border-[#E9D8BD]/60 text-xs text-[#35251D]/75">
              {isRegisterMode ? (
                <span>
                  Sudah punya akun?{' '}
                  <button
                    type="button"
                    onClick={() => setIsRegisterMode(false)}
                    className="text-[#8B4A2B] font-bold hover:underline"
                  >
                    Log In
                  </button>
                </span>
              ) : (
                <span>
                  Belum punya akun?{' '}
                  <button
                    type="button"
                    onClick={() => setIsRegisterMode(true)}
                    className="text-[#8B4A2B] font-bold hover:underline"
                  >
                    Daftar Akun
                  </button>
                </span>
              )}
            </div>

            {/* Akses Demo Cepat */}
            <div className="pt-2 text-center">
              <span className="text-[10px] text-gray-400 block mb-1.5">Akses Demo Cepat:</span>
              <div className="flex justify-center gap-2">
                <button
                  type="button"
                  onClick={() => handleQuickDemoLogin('member')}
                  className="px-3 py-1 rounded-lg bg-gray-100 hover:bg-gray-200 text-[#173D2B] text-[10px] font-bold"
                >
                  Masuk Wisatawan
                </button>
                <button
                  type="button"
                  onClick={() => handleQuickDemoLogin('admin')}
                  className="px-3 py-1 rounded-lg bg-[#173D2B] hover:bg-[#102B1E] text-white text-[10px] font-bold"
                >
                  Masuk Admin
                </button>
              </div>
            </div>

            {/* Tulisan Kecil Portal Admin di Bagian Paling Bawah */}
            <div className="pt-3 border-t border-gray-100 text-center">
              <button
                type="button"
                onClick={onGoToAdmin}
                className="text-[11px] text-gray-400 hover:text-[#8B4A2B] hover:underline transition"
              >
                portal admin
              </button>
            </div>
          </div>
        </div>
      );
    }

    // =========================================================================
    // 3. MAIN APPLICATION COMPONENT
    // =========================================================================
    function App() {
      // Navigation Routes: 'beranda', 'explore', 'sejarah', 'galeri', 'simulator', 'reviews', 'admin_dashboard'
      const [currentRoute, setCurrentRoute] = useState('beranda');

      // Mobile Hamburger Navigation Drawer
      const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);

      // Session Autentikasi Pengguna
      const [currentUser, setCurrentUser] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_user_session');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return null;
      });

      // Split Screen Login Modal State
      const [isLoginModalOpen, setIsLoginModalOpen] = useState(false);
      const [isProfileModalOpen, setIsProfileModalOpen] = useState(false);

      // Form Login State
      const [loginIdentifier, setLoginIdentifier] = useState('');
      const [loginPassword, setLoginPassword] = useState('');
      const [showPassword, setShowPassword] = useState(false);
      const [rememberMe, setRememberMe] = useState(true);
      const [loginLoading, setLoginLoading] = useState(false);
      const [loginError, setLoginError] = useState('');
      const [loginToast, setLoginToast] = useState('');

      // Master Datasets with LocalStorage Persistence
      const [products, setProducts] = useState(() => {
        try {
          const saved = localStorage.getItem('syakira_products_list_v2');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_PRODUCTS;
      });

      const [destinations, setDestinations] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_destinations_list_v2');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_TOUR_DESTINATIONS;
      });

      const [videos, setVideos] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_videos_list_v2');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_VIDEOS;
      });

      const [guides, setGuides] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_guides_list_v2');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_TOUR_GUIDES;
      });

      const [reviews, setReviews] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_visitor_reviews');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_REVIEWS;
      });

      const [usersList, setUsersList] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_users_master');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_USERS;
      });

      const [bookings, setBookings] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_bookings_master');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_BOOKINGS;
      });

      const [articles, setArticles] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_articles_master');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_ARTICLES;
      });

      const [galleryList, setGalleryList] = useState(() => {
        try {
          const saved = localStorage.getItem('sukaregang_gallery_master');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return DEFAULT_GALLERY;
      });

      // Custom images uploaded via Admin Studio
      const [customImages, setCustomImages] = useState(() => {
        try {
          const saved = localStorage.getItem('syakira_custom_product_images');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return {};
      });

      // Selected product for detail modal
      const [selectedProduct, setSelectedProduct] = useState(null);

      // Map interactive spot
      const [selectedMapLoc, setSelectedMapLoc] = useState(destinations[0] || DEFAULT_TOUR_DESTINATIONS[0]);
      const mapContainerRef = useRef(null);
      const mapInstanceRef = useRef(null);

      // Tour Guide Booking State
      const [selectedGuide, setSelectedGuide] = useState(guides[0] || DEFAULT_TOUR_GUIDES[0]);
      const [bookingName, setBookingName] = useState('');
      const [bookingWA, setBookingWA] = useState('');
      const [bookingDate, setBookingDate] = useState('');
      const [bookingTime, setBookingTime] = useState('09:00 WIB (Pagi)');
      const [bookingPeople, setBookingPeople] = useState('2');
      const [selectedDestinations, setSelectedDestinations] = useState([
        'Pabrik Jaket Kulit Sukaregang (Lokasi 1)',
        'Pusat Belanja Piazza Firenze Garut',
      ]);
      const [bookingNote, setBookingNote] = useState('');

      // Auto-fill booking info
      useEffect(() => {
        if (currentUser) {
          if (!bookingName) setBookingName(currentUser.name);
          if (!bookingWA) setBookingWA(currentUser.phone);
        }
      }, [currentUser]);

      // Category & Filter
      const [storeCategory, setStoreCategory] = useState('Semua');
      const [searchQuery, setSearchQuery] = useState('');

      // Form Kesan Pesan Baru
      const [revName, setRevName] = useState('');
      const [revCity, setRevCity] = useState('');
      const [revVisited, setRevVisited] = useState('Showroom Syakira Leather Sukaregang');
      const [revRating, setRevRating] = useState(5);
      const [revComment, setRevComment] = useState('');

      // Literasi Sejarah & Edukasi State
      const [sejarahActiveTab, setSejarahActiveTab] = useState('sejarah'); // 'sejarah', 'jenis_kulit', 'produksi', 'perawatan', 'asli_palsu', 'video'
      const [playingVideoId, setPlayingVideoId] = useState(null);

      // State Admin Tambah Video YouTube
      const [newVidTitle, setNewVidTitle] = useState('');
      const [newVidUrl, setNewVidUrl] = useState('');
      const [newVidCategory, setNewVidCategory] = useState('Sejarah Garut');
      const [newVidDesc, setNewVidDesc] = useState('');

      const extractYoutubeId = (url) => {
        if (!url) return '';
        const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
        return match ? match[1] : url.trim();
      };

      // =======================================================================
      // GAME SIMULATOR 3D (LEATHER CRAFT ADVENTURE - 7 LEVEL GAMEPLAY)
      // =======================================================================
      const [simGameMode, setSimGameMode] = useState('menu'); // 'menu', 'jaket', 'sepatu'
      const [simLevel, setSimLevel] = useState(1); // Level 1 to 7
      const [simScore, setSimScore] = useState(100);
      const [simCoins, setSimCoins] = useState(50);
      const [simAudioFeedback, setSimAudioFeedback] = useState('');

      // Jaket Choices
      const [jaketDesign, setJaketDesign] = useState('Jaket Biker');
      const [jaketColor, setJaketColor] = useState('Hitam Obsidian');
      const [jaketMaterial, setJaketMaterial] = useState('Kulit Domba Garut Grade A');
      const [jaketCollar, setJaketCollar] = useState('Kerah Snap Button');
      const [jaketZipper, setJaketZipper] = useState('Ritsleting Logam Kuningan YKK');

      // Jaket Interactive Mini-Actions
      const [jaketCutParts, setJaketCutParts] = useState({
        depan: false,
        belakang: false,
        lengan: false,
        kerah: false
      });
      const [isSewingActive, setIsSewingActive] = useState(false);
      const [sewingProgress, setSewingProgress] = useState(0);
      const [assembledParts, setAssembledParts] = useState({
        depan: false,
        belakang: false,
        lengan: false,
        kerah: false,
        zipper: false,
        furing: false
      });
      const [cleanPassed, setCleanPassed] = useState(false);
      const [minkOilApplied, setMinkOilApplied] = useState(false);

      // Sepatu Choices
      const [sepatuDesign, setSepatuDesign] = useState('Sepatu Boots');
      const [sepatuColor, setSepatuColor] = useState('Cokelat Antik Heritage');
      const [sepatuLeather, setSepatuLeather] = useState('Kulit Sapi Pull-Up Asli');
      const [sepatuSole, setSepatuSole] = useState('Sol Karet Komando Anti Slip');

      // Sepatu Interactive Mini-Actions
      const [sepatuCutParts, setSepatuCutParts] = useState({
        vamp: false,
        quarter: false,
        tongue: false,
        heel: false
      });
      const [sepatuSewProgress, setSepatuSewProgress] = useState(0);
      const [soleAttached, setSoleAttached] = useState(false);
      const [shoePolished, setShoePolished] = useState(false);

      // Audio feedback cue helper
      const triggerEffect = (text) => {
        setSimAudioFeedback(text);
        setTimeout(() => setSimAudioFeedback(''), 1500);
      };

      // =======================================================================
      // DASHBOARD ADMIN FULL SCREEN STATE & CRUD
      // =======================================================================
      const [adminSidebarCollapsed, setAdminSidebarCollapsed] = useState(false);
      const [adminActiveTab, setAdminActiveTab] = useState('overview'); // overview, users, products, destinations, guides, bookings, reviews, gallery, history, game, reports, settings
      const [adminSearch, setAdminSearch] = useState('');
      const [adminFilter, setAdminFilter] = useState('Semua');

      // Admin CRUD Modals
      const [adminModalMode, setAdminModalMode] = useState(null); // 'add_product', 'edit_product', 'add_dest', 'edit_dest', 'add_user', 'edit_user', 'add_booking', 'edit_booking', 'add_article', 'add_gallery'
      const [adminFormData, setAdminFormData] = useState({});

      // Scroll to top on route change
      useEffect(() => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setIsMobileMenuOpen(false);
      }, [currentRoute]);

      // Initialize Leaflet Map
      useEffect(() => {
        if (currentRoute !== 'explore' || !mapContainerRef.current) return;
        if (!mapInstanceRef.current) {
          const map = L.map(mapContainerRef.current).setView([-7.2148, 107.9155], 15);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap | Sukaregang Discovery',
          }).addTo(map);
          mapInstanceRef.current = map;
        }

        const map = mapInstanceRef.current;
        map.eachLayer((layer) => {
          if (layer instanceof L.Marker) map.removeLayer(layer);
        });

        destinations.forEach((dest) => {
          const marker = L.marker(dest.coordinates).addTo(map);
          marker.bindPopup(`
            <div style="padding: 4px; min-width: 200px; font-family: sans-serif;">
              <span style="font-size: 10px; color: #8B4A2B; font-weight: bold; text-transform: uppercase;">${dest.category}</span>
              <h4 style="margin: 2px 0 6px 0; font-size: 13px; font-weight: bold; color: #173D2B;">${dest.name}</h4>
              <p style="margin: 0 0 8px 0; font-size: 11px; color: #555;">${dest.address}</p>
              <a href="${dest.googleMapsUrl}" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 5px 9px; background: #173D2B; color: #F8F4EC; border-radius: 6px; font-size: 11px; text-decoration: none; font-weight: bold;">
                Buka Link Google Maps ↗
              </a>
            </div>
          `);
          marker.on('click', () => setSelectedMapLoc(dest));
        });
      }, [currentRoute, destinations]);

      // Login Handler
      const handleLoginSubmit = (e) => {
        e.preventDefault();
        setLoginError('');

        if (!loginIdentifier.trim()) {
          setLoginError('Mohon masukkan Email atau Username Anda.');
          return;
        }
        if (!loginPassword) {
          setLoginError('Mohon masukkan kata sandi Anda.');
          return;
        }

        setLoginLoading(true);

        setTimeout(() => {
          setLoginLoading(false);
          const isRoleAdmin = loginIdentifier.toLowerCase().includes('admin');
          const user = {
            id: 'usr-' + Date.now(),
            name: loginIdentifier.includes('@') ? loginIdentifier.split('@')[0] : loginIdentifier,
            email: loginIdentifier.includes('@') ? loginIdentifier : `${loginIdentifier}@sukaregang.id`,
            phone: '+62 812-3456-7890',
            role: isRoleAdmin ? 'admin' : 'member',
            avatarUrl: './logo.png',
            joinDate: '14 November 2026',
          };

          setCurrentUser(user);
          if (rememberMe) {
            try {
              localStorage.setItem('sukaregang_user_session', JSON.stringify(user));
            } catch (err) {}
          }

          setLoginToast(`Selamat datang kembali, ${user.name}!`);
          setTimeout(() => {
            setLoginToast('');
            setIsLoginModalOpen(false);
            if (isRoleAdmin) {
              setCurrentRoute('admin_dashboard');
            } else {
              setCurrentRoute('beranda');
            }
          }, 600);
        }, 500);
      };

      const handleQuickDemoLogin = (role = 'member') => {
        const demoUser = {
          id: 'usr-demo-01',
          name: role === 'admin' ? 'Admin Syakira' : 'Wisatawan Garut',
          email: role === 'admin' ? 'admin@syakiraleather.com' : 'wisatawan@sukaregang.id',
          phone: '+62 812-3456-7890',
          role: role,
          avatarUrl: './logo.png',
          joinDate: '14 November 2026',
        };
        setCurrentUser(demoUser);
        try {
          localStorage.setItem('sukaregang_user_session', JSON.stringify(demoUser));
        } catch (err) {}
        setLoginToast(`Masuk sebagai ${demoUser.name}`);
        setTimeout(() => {
          setLoginToast('');
          setIsLoginModalOpen(false);
          if (role === 'admin') {
            setCurrentRoute('admin_dashboard');
          } else {
            setCurrentRoute('beranda');
          }
        }, 600);
      };

      const handleLogout = () => {
        setCurrentUser(null);
        try {
          localStorage.removeItem('sukaregang_user_session');
        } catch (err) {}
        setIsProfileModalOpen(false);
        if (currentRoute === 'admin_dashboard') {
          setCurrentRoute('beranda');
        }
      };

      // Booking Submit
      const handleSendWhatsAppOrder = () => {
        if (!bookingName.trim()) {
          alert('Mohon masukkan nama pemesan.');
          return;
        }
        if (!bookingDate) {
          alert('Mohon pilih tanggal kunjungan.');
          return;
        }

        const destinationListText = selectedDestinations.map((d, i) => `${i + 1}. ${d}`).join('\n');
        const messageText = `Halo Kak ${selectedGuide.name}, saya ingin memesan pendampingan Tour Guide Sukaregang Discovery Garut.

📋 *Rincian Pemesanan Wisata Kulit:*
• *Nama Pemesan:* ${bookingName}
• *No. WhatsApp:* ${bookingWA || '-'}
• *Pilihan Guide:* ${selectedGuide.name} (${selectedGuide.phone})
• *Tanggal:* ${bookingDate}
• *Waktu Kunjungan:* ${bookingTime}
• *Jumlah Orang:* ${bookingPeople} Orang

📍 *Destinasi Pilihan yang Ingin Dikunjungi:*
${destinationListText}

${bookingNote ? `💬 *Catatan Khusus:* ${bookingNote}\n\n` : ''}Mohon konfirmasi ketersediaan jadwal Kakak ya. Terima kasih banyak!`;

        // Simpan juga ke database booking
        const newBookingRecord = {
          id: 'bkg-' + Date.now(),
          customerName: bookingName,
          phone: bookingWA || '-',
          guideName: selectedGuide.name,
          date: bookingDate,
          time: bookingTime,
          people: bookingPeople,
          destinations: selectedDestinations.join(', '),
          status: 'Menunggu'
        };
        const updatedBookings = [newBookingRecord, ...bookings];
        setBookings(updatedBookings);
        try {
          localStorage.setItem('sukaregang_bookings_master', JSON.stringify(updatedBookings));
        } catch (e) {}

        const encodedMsg = encodeURIComponent(messageText);
        const waUrl = `https://wa.me/${selectedGuide.waNumber}?text=${encodedMsg}`;
        window.open(waUrl, '_blank');
      };

      // Review Submit
      const handleAddReview = (e) => {
        e.preventDefault();
        if (!revName.trim() || !revComment.trim()) {
          alert('Mohon isi nama dan kesan pesan Anda.');
          return;
        }

        const newReview = {
          id: 'rev-' + Date.now(),
          name: revName.trim(),
          city: revCity.trim() || 'Wisatawan Nusantara',
          date: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }),
          rating: parseInt(revRating) || 5,
          destinationVisited: revVisited,
          comment: revComment.trim()
        };

        const updated = [newReview, ...reviews];
        setReviews(updated);
        try {
          localStorage.setItem('sukaregang_visitor_reviews', JSON.stringify(updated));
        } catch (err) {}

        setRevName('');
        setRevCity('');
        setRevComment('');
        alert('Kesan & pesan Anda berhasil dipublikasikan!');
      };

      // Filtered Products for Galeri
      const filteredProducts = useMemo(() => {
        let list = [...products];
        if (storeCategory !== 'Semua') {
          list = list.filter((p) => p.category === storeCategory);
        }
        if (searchQuery.trim() !== '') {
          const q = searchQuery.toLowerCase();
          list = list.filter(
            (p) => p.name.toLowerCase().includes(q) || p.description.toLowerCase().includes(q)
          );
        }
        return list;
      }, [products, storeCategory, searchQuery]);

      // =======================================================================
      // RENDER: HALAMAN LOGIN TERPISAH (STANDALONE SPLIT-SCREEN FULL PAGE)
      // =======================================================================
      if (currentRoute === 'login') {
        return (
          <LoginPage
            currentUser={currentUser}
            onBack={() => setCurrentRoute('beranda')}
            onGoToAdmin={() => setCurrentRoute('admin_dashboard')}
            loginIdentifier={loginIdentifier}
            setLoginIdentifier={setLoginIdentifier}
            loginPassword={loginPassword}
            setLoginPassword={setLoginPassword}
            showPassword={showPassword}
            setShowPassword={setShowPassword}
            rememberMe={rememberMe}
            setRememberMe={setRememberMe}
            loginLoading={loginLoading}
            loginError={loginError}
            loginToast={loginToast}
            handleLoginSubmit={handleLoginSubmit}
            handleQuickDemoLogin={handleQuickDemoLogin}
          />
        );
      }

      // =======================================================================
      // RENDER: DASHBOARD ADMIN FULL SCREEN (LAYOUT TERPISAH DARI USER)
      // =======================================================================
      if (currentRoute === 'admin_dashboard') {
        return (
          <div className="min-h-screen bg-[#F0EBE1] flex flex-col lg:flex-row text-[#35251D] font-sans antialiased">
            
            {/* SIDEBAR ADMIN KIRI (FULL SCREEN & COLLAPSIBLE) */}
            <aside className={`bg-[#102B1E] text-[#F8F4EC] transition-all duration-300 flex flex-col justify-between z-30 shadow-2xl ${adminSidebarCollapsed ? 'w-20' : 'w-72'}`}>
              <div>
                {/* Logo & Toggle Header */}
                <div className="p-4 border-b border-[#E9D8BD]/20 flex items-center justify-between">
                  <div className={`flex items-center space-x-3 overflow-hidden ${adminSidebarCollapsed ? 'hidden' : 'flex'}`}>
                    <img src="./logo.png" alt="Logo" className="w-10 h-10 object-contain drop-shadow" />
                    <div>
                      <h4 className="font-serif font-bold text-sm tracking-wide text-[#F8F4EC]">ADMIN PORTAL</h4>
                      <span className="text-[10px] text-[#E9D8BD] block font-semibold uppercase">Sukaregang Discovery</span>
                    </div>
                  </div>
                  {adminSidebarCollapsed && (
                    <img src="./logo.png" alt="Logo" className="w-9 h-9 mx-auto object-contain" />
                  )}
                  <button
                    onClick={() => setAdminSidebarCollapsed(!adminSidebarCollapsed)}
                    className="p-1.5 rounded-lg bg-white/10 hover:bg-[#8B4A2B] text-white transition hidden lg:block"
                    title="Perkecil / Perbesar Sidebar"
                  >
                    <Icon name={adminSidebarCollapsed ? "chevron-right" : "chevron-left"} className="w-4 h-4" />
                  </button>
                </div>

                {/* Navigation Menu Links */}
                <nav className="p-3 space-y-1 text-xs font-semibold overflow-y-auto max-h-[calc(100vh-140px)] custom-scroll">
                  {[
                    { id: 'overview', icon: 'layout-dashboard', label: '📊 Dashboard Overview' },
                    { id: 'users', icon: 'users', label: '👥 Kelola Pengguna' },
                    { id: 'products', icon: 'shopping-bag', label: '🛍️ Kelola Produk' },
                    { id: 'destinations', icon: 'map-pin', label: '📍 Kelola Destinasi' },
                    { id: 'guides', icon: 'compass', label: '🧭 Kelola Tour Guide' },
                    { id: 'bookings', icon: 'calendar-check', label: '📅 Kelola Booking' },
                    { id: 'reviews', icon: 'message-square', label: '💬 Kelola Kesan & Pesan' },
                    { id: 'gallery', icon: 'image', label: '🖼️ Kelola Galeri' },
                    { id: 'history', icon: 'book-open', label: '📜 Kelola Sejarah' },
                    { id: 'videos', icon: 'video', label: '🎥 Kelola Video YouTube' },
                    { id: 'game', icon: 'gamepad-2', label: '🎮 Kelola Game' },
                    { id: 'reports', icon: 'bar-chart-3', label: '📈 Laporan' },
                    { id: 'settings', icon: 'settings', label: '⚙️ Pengaturan' },
                  ].map((m) => (
                    <button
                      key={m.id}
                      onClick={() => setAdminActiveTab(m.id)}
                      className={`w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl transition ${
                        adminActiveTab === m.id
                          ? 'bg-[#E9D8BD] text-[#173D2B] font-bold shadow-md'
                          : 'text-[#F8F4EC]/80 hover:bg-white/10 hover:text-white'
                      }`}
                      title={m.label}
                    >
                      <Icon name={m.icon} className="w-4 h-4 flex-shrink-0" />
                      {!adminSidebarCollapsed && <span className="truncate">{m.label}</span>}
                    </button>
                  ))}
                </nav>
              </div>

              {/* Sidebar Footer: Back to Website / Logout */}
              <div className="p-3 border-t border-[#E9D8BD]/20 space-y-1">
                <button
                  onClick={() => setCurrentRoute('beranda')}
                  className="w-full flex items-center space-x-2.5 px-3 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition"
                  title="Lihat Website"
                >
                  <Icon name="globe" className="w-4 h-4" />
                  {!adminSidebarCollapsed && <span>Lihat Website</span>}
                </button>
                <button
                  onClick={handleLogout}
                  className="w-full flex items-center space-x-2.5 px-3 py-2 rounded-xl bg-red-600/30 hover:bg-red-600 text-white text-xs font-bold transition"
                  title="Keluar dari Admin"
                >
                  <Icon name="log-out" className="w-4 h-4" />
                  {!adminSidebarCollapsed && <span>Logout Admin</span>}
                </button>
              </div>
            </aside>

            {/* AREA KANAN: TOPBAR & MAIN CONTENT FULL SCREEN */}
            <div className="flex-1 flex flex-col min-h-screen overflow-x-hidden">
              
              {/* Topbar Admin */}
              <header className="h-16 bg-white border-b border-[#E9D8BD]/40 px-6 flex items-center justify-between shadow-sm">
                <div className="flex items-center space-x-3">
                  <button
                    onClick={() => setAdminSidebarCollapsed(!adminSidebarCollapsed)}
                    className="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 lg:hidden"
                  >
                    <Icon name="menu" className="w-5 h-5 text-[#173D2B]" />
                  </button>
                  <div className="text-xs text-[#35251D]">
                    <span className="text-gray-400">Admin</span> / <span className="font-bold capitalize">{adminActiveTab}</span>
                  </div>
                </div>

                <div className="flex items-center space-x-4">
                  <div className="relative hidden sm:block">
                    <input
                      type="text"
                      placeholder="Cari data..."
                      value={adminSearch}
                      onChange={(e) => setAdminSearch(e.target.value)}
                      className="pl-8 pr-3 py-1.5 rounded-xl border border-[#E9D8BD] text-xs bg-[#F8F4EC]/50 focus:outline-none focus:border-[#173D2B]"
                    />
                    <Icon name="search" className="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-gray-400" />
                  </div>

                  <div className="flex items-center space-x-2 border-l border-gray-200 pl-4">
                    <img src="./logo.png" alt="Admin Avatar" className="w-8 h-8 rounded-full border border-[#E9D8BD] object-contain bg-[#173D2B]" />
                    <div className="text-left text-xs leading-tight hidden sm:block">
                      <span className="font-bold text-[#173D2B] block">Alya Alifia</span>
                      <span className="text-[10px] text-emerald-600 font-bold block">Super Admin</span>
                    </div>
                  </div>
                </div>
              </header>

              {/* Main Admin Content Canvas */}
              <main className="p-6 flex-1 space-y-6 overflow-y-auto custom-scroll">
                
                {/* 1. DASHBOARD OVERVIEW */}
                {adminActiveTab === 'overview' && (
                  <div className="space-y-6 animate-fadeIn">
                    <div className="flex items-center justify-between">
                      <div>
                        <h2 className="font-serif text-2xl font-bold text-[#173D2B]">Executive Dashboard Overview</h2>
                        <p className="text-xs text-[#35251D]/70">Laporan real-time statistik pariwisata digital, produk kulit & ulasan Sukaregang.</p>
                      </div>
                      <button
                        onClick={() => setCurrentRoute('simulator')}
                        className="px-4 py-2 bg-[#8B4A2B] text-white rounded-xl text-xs font-bold hover:bg-[#6E381F] transition shadow"
                      >
                        🎮 Buka Game Simulator
                      </button>
                    </div>

                    {/* 6 Metrik Kartu Utama */}
                    <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
                      {[
                        { title: 'Total Pengguna', value: usersList.length, icon: 'users', color: 'bg-blue-50 text-blue-700' },
                        { title: 'Total Produk', value: products.length, icon: 'shopping-bag', color: 'bg-emerald-50 text-emerald-700' },
                        { title: 'Total Destinasi', value: destinations.length, icon: 'map-pin', color: 'bg-amber-50 text-amber-700' },
                        { title: 'Tour Guide', value: guides.length, icon: 'compass', color: 'bg-purple-50 text-purple-700' },
                        { title: 'Pemesanan', value: bookings.length, icon: 'calendar-check', color: 'bg-rose-50 text-rose-700' },
                        { title: 'Total Ulasan', value: reviews.length, icon: 'message-square', color: 'bg-teal-50 text-teal-700' },
                      ].map((card) => (
                        <div key={card.title} className="p-4 bg-white rounded-2xl border border-[#E9D8BD] shadow-sm flex flex-col justify-between space-y-2">
                          <span className={`w-8 h-8 rounded-xl flex items-center justify-center ${card.color}`}>
                            <Icon name={card.icon} className="w-4 h-4" />
                          </span>
                          <div>
                            <span className="text-[10px] text-gray-500 block uppercase font-bold">{card.title}</span>
                            <span className="text-xl font-bold text-[#173D2B]">{card.value}</span>
                          </div>
                        </div>
                      ))}
                    </div>

                    {/* Grafik Visual Statistik Kunjungan (Canvas / SVG) */}
                    <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4">
                      <div className="flex items-center justify-between">
                        <h4 className="font-serif font-bold text-sm text-[#173D2B]">Tren Minat Wisata & Kunjungan Sukaregang (Bulan Ini)</h4>
                        <span className="text-xs text-emerald-700 font-bold bg-emerald-100 px-2 py-0.5 rounded-full">↑ +24.8% Naik</span>
                      </div>
                      <div className="h-44 w-full flex items-end justify-between gap-2 pt-6 pb-2 border-b border-gray-200">
                        {[
                          { day: 'Sen', val: 40 },
                          { day: 'Sel', val: 55 },
                          { day: 'Rab', val: 70 },
                          { day: 'Kam', val: 65 },
                          { day: 'Jum', val: 90 },
                          { day: 'Sab', val: 140 },
                          { day: 'Min', val: 160 },
                        ].map((bar) => (
                          <div key={bar.day} className="flex-1 flex flex-col items-center gap-1.5 group">
                            <span className="text-[10px] font-bold text-[#8B4A2B] opacity-0 group-hover:opacity-100 transition">{bar.val}</span>
                            <div
                              className="w-full bg-[#173D2B] rounded-t-xl hover:bg-[#8B4A2B] transition-all"
                              style={{ height: `${(bar.val / 160) * 120}px` }}
                            ></div>
                            <span className="text-[10px] text-gray-500 font-bold">{bar.day}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    {/* Aktivitas Pemesanan Terbaru */}
                    <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4">
                      <h4 className="font-serif font-bold text-sm text-[#173D2B]">Pemesanan Tour Guide Terbaru</h4>
                      <div className="overflow-x-auto">
                        <table className="w-full text-left text-xs">
                          <thead>
                            <tr className="border-b text-gray-400 uppercase text-[10px]">
                              <th className="pb-2">Pemesan</th>
                              <th className="pb-2">Pemandu</th>
                              <th className="pb-2">Tanggal</th>
                              <th className="pb-2">Destinasi</th>
                              <th className="pb-2">Status</th>
                            </tr>
                          </thead>
                          <tbody className="divide-y divide-gray-100">
                            {bookings.map((b) => (
                              <tr key={b.id} className="hover:bg-gray-50">
                                <td className="py-2.5 font-bold text-[#173D2B]">{b.customerName}</td>
                                <td className="py-2.5">{b.guideName}</td>
                                <td className="py-2.5">{b.date} ({b.time})</td>
                                <td className="py-2.5 truncate max-w-[200px]">{b.destinations}</td>
                                <td className="py-2.5">
                                  <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${b.status === 'Terkonfirmasi' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>
                                    {b.status}
                                  </span>
                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                )}

                {/* 2. KELOLA PENGGUNA (FULL CRUD) */}
                {adminActiveTab === 'users' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <div>
                        <h3 className="font-serif font-bold text-lg text-[#173D2B]">Kelola Akun Pengguna ({usersList.length})</h3>
                        <p className="text-xs text-gray-500">Lihat, edit hak akses, atau hapus pengguna aplikasi.</p>
                      </div>
                      <button
                        onClick={() => {
                          const name = prompt('Nama Pengguna Baru:');
                          if (!name) return;
                          const email = prompt('Email:');
                          const phone = prompt('Nomor WhatsApp:');
                          const role = prompt('Role (admin / member):', 'member');
                          const newUser = {
                            id: 'usr-' + Date.now(),
                            name: name.trim(),
                            email: email || `${name.toLowerCase()}@sukaregang.id`,
                            phone: phone || '+62 812-0000-0000',
                            role: role === 'admin' ? 'admin' : 'member',
                            status: 'Aktif',
                            joinDate: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })
                          };
                          const updated = [...usersList, newUser];
                          setUsersList(updated);
                          localStorage.setItem('sukaregang_users_master', JSON.stringify(updated));
                        }}
                        className="px-4 py-2 bg-[#173D2B] text-white text-xs font-bold rounded-xl hover:bg-[#102B1E] transition flex items-center space-x-1.5"
                      >
                        <Icon name="plus" className="w-4 h-4" />
                        <span>Tambah Pengguna</span>
                      </button>
                    </div>

                    <div className="overflow-x-auto">
                      <table className="w-full text-left text-xs">
                        <thead>
                          <tr className="border-b text-gray-400 uppercase text-[10px]">
                            <th className="pb-3">Nama</th>
                            <th className="pb-3">Email & WhatsApp</th>
                            <th className="pb-3">Role</th>
                            <th className="pb-3">Status</th>
                            <th className="pb-3 text-right">Aksi</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-100">
                          {usersList.map((u) => (
                            <tr key={u.id} className="hover:bg-gray-50">
                              <td className="py-3 font-bold text-[#173D2B]">{u.name}</td>
                              <td className="py-3">{u.email} <br /><span className="text-[10px] text-gray-500">{u.phone}</span></td>
                              <td className="py-3">
                                <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${u.role === 'admin' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800'}`}>
                                  {u.role}
                                </span>
                              </td>
                              <td className="py-3 text-emerald-700 font-bold">✓ {u.status}</td>
                              <td className="py-3 text-right space-x-2">
                                <button
                                  onClick={() => {
                                    const newName = prompt('Ubah Nama Pengguna:', u.name);
                                    if (newName) {
                                      const updated = usersList.map(usr => usr.id === u.id ? { ...usr, name: newName } : usr);
                                      setUsersList(updated);
                                      localStorage.setItem('sukaregang_users_master', JSON.stringify(updated));
                                    }
                                  }}
                                  className="text-blue-600 hover:underline font-bold"
                                >
                                  Edit
                                </button>
                                <button
                                  onClick={() => {
                                    if (!confirm(`Hapus akun ${u.name}?`)) return;
                                    const updated = usersList.filter(usr => usr.id !== u.id);
                                    setUsersList(updated);
                                    localStorage.setItem('sukaregang_users_master', JSON.stringify(updated));
                                  }}
                                  className="text-red-600 hover:underline font-bold"
                                >
                                  Hapus
                                </button>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}

                {/* 3. KELOLA PRODUK (20 PRODUK + CRUD LENGKAP) */}
                {adminActiveTab === 'products' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-5 animate-fadeIn">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <div>
                        <h3 className="font-serif font-bold text-lg text-[#173D2B]">Katalog Produk Syakira Leather ({products.length})</h3>
                        <p className="text-xs text-gray-500">Tambah produk baru dengan upload foto, edit spesifikasi & link Shopee.</p>
                      </div>
                      <div className="flex gap-2">
                        <button
                          onClick={() => {
                            if (!confirm('Kembalikan ke 20 produk asli default?')) return;
                            setProducts(DEFAULT_PRODUCTS);
                            setCustomImages({});
                            localStorage.removeItem('syakira_products_list_v2');
                            alert('Katalog telah di-reset.');
                          }}
                          className="px-3 py-2 bg-gray-100 text-gray-700 text-xs font-bold rounded-xl hover:bg-gray-200 transition"
                        >
                          🔄 Reset 20 Produk
                        </button>
                        <button
                          onClick={() => {
                            const name = prompt('Nama Produk:');
                            if (!name) return;
                            const category = prompt('Kategori (Jaket Kulit Pria / Sepatu Pria / Sepatu Wanita / Aksesoris):', 'Jaket Kulit Pria');
                            const price = prompt('Harga (Contoh: Rp 1.450.000):', 'Rp 1.450.000');
                            const shopeeUrl = prompt('Link Shopee:', SYAKIRA_OFFICIAL_SHOPEE_STORE);
                            const imgUrl = prompt('URL Gambar Foto Produk:', 'https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&w=600&q=80');
                            const newProd = {
                              id: 'prod-' + Date.now(),
                              name: name.trim(),
                              category: category || 'Jaket Kulit Pria',
                              price: price || 'Rp 1.200.000',
                              storeName: 'Syakira Leather',
                              shopeeUrl: shopeeUrl || SYAKIRA_OFFICIAL_SHOPEE_STORE,
                              imageId: 'custom-' + Date.now(),
                              imageUrl: imgUrl,
                              fallbackUrl: imgUrl,
                              description: 'Produk kerajinan kulit asli bermutu tinggi Syakira Leather Sukaregang Garut.',
                              materialInfo: '100% Kulit Asli Garut'
                            };
                            const updated = [newProd, ...products];
                            setProducts(updated);
                            localStorage.setItem('syakira_products_list_v2', JSON.stringify(updated));
                          }}
                          className="px-4 py-2 bg-[#173D2B] text-white text-xs font-bold rounded-xl hover:bg-[#102B1E] transition flex items-center space-x-1.5"
                        >
                          <Icon name="plus" className="w-4 h-4" />
                          <span>Tambah Produk Baru</span>
                        </button>
                      </div>
                    </div>

                    <div className="overflow-x-auto">
                      <table className="w-full text-left text-xs">
                        <thead>
                          <tr className="border-b text-gray-400 uppercase text-[10px]">
                            <th className="pb-3">Foto</th>
                            <th className="pb-3">Nama Produk</th>
                            <th className="pb-3">Kategori</th>
                            <th className="pb-3">Harga</th>
                            <th className="pb-3">Shopee</th>
                            <th className="pb-3 text-right">Aksi</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-100">
                          {products.map((p) => (
                            <tr key={p.id} className="hover:bg-gray-50">
                              <td className="py-2.5">
                                <img
                                  src={customImages[p.id] || p.imageUrl}
                                  alt={p.name}
                                  referrerPolicy="no-referrer"
                                  className="w-12 h-12 rounded-lg object-cover border border-[#E9D8BD]"
                                  onError={(e) => {
                                    e.target.onerror = null;
                                    e.target.src = p.fallbackUrl || "https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&w=200&q=80";
                                  }}
                                />
                              </td>
                              <td className="py-2.5 font-bold text-[#173D2B] max-w-[200px] truncate">{p.name}</td>
                              <td className="py-2.5 text-[#8B4A2B] font-bold">{p.category}</td>
                              <td className="py-2.5 font-semibold">{p.price || 'Rp 1.450.000'}</td>
                              <td className="py-2.5">
                                <a href={p.shopeeUrl} target="_blank" className="text-blue-600 hover:underline">
                                  Buka Shopee ↗
                                </a>
                              </td>
                              <td className="py-2.5 text-right space-x-2">
                                <button
                                  onClick={() => {
                                    const newPrice = prompt('Ubah Harga:', p.price || 'Rp 1.450.000');
                                    if (newPrice) {
                                      const updated = products.map(prod => prod.id === p.id ? { ...prod, price: newPrice } : prod);
                                      setProducts(updated);
                                      localStorage.setItem('syakira_products_list_v2', JSON.stringify(updated));
                                    }
                                  }}
                                  className="text-blue-600 hover:underline font-bold"
                                >
                                  Edit
                                </button>
                                <button
                                  onClick={() => {
                                    if (!confirm(`Hapus produk ${p.name}?`)) return;
                                    const updated = products.filter(prod => prod.id !== p.id);
                                    setProducts(updated);
                                    localStorage.setItem('syakira_products_list_v2', JSON.stringify(updated));
                                  }}
                                  className="text-red-600 hover:underline font-bold"
                                >
                                  Hapus
                                </button>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}

                {/* 4. KELOLA DESTINASI PETA */}
                {adminActiveTab === 'destinations' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn">
                    <div className="flex items-center justify-between">
                      <h3 className="font-serif font-bold text-lg text-[#173D2B]">Titik Destinasi & Pabrik ({destinations.length})</h3>
                      <button
                        onClick={() => {
                          const name = prompt('Nama Destinasi/Pabrik:');
                          if (!name) return;
                          const category = prompt('Kategori:', 'Pabrik Jaket');
                          const mapsUrl = prompt('Link Google Maps:');
                          const newD = {
                            id: 'dest-' + Date.now(),
                            name: name.trim(),
                            category: category || 'Pabrik Kulit',
                            address: 'Sukaregang, Garut',
                            googleMapsUrl: mapsUrl || 'https://maps.google.com',
                            coordinates: [-7.2150, 107.9150],
                            description: 'Sentra produksi kulit terpercaya Sukaregang Garut.',
                            image: 'https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=600&q=80'
                          };
                          const updated = [...destinations, newD];
                          setDestinations(updated);
                          localStorage.setItem('sukaregang_destinations_list_v2', JSON.stringify(updated));
                        }}
                        className="px-4 py-2 bg-[#173D2B] text-white text-xs font-bold rounded-xl"
                      >
                        + Tambah Destinasi
                      </button>
                    </div>

                    <div className="space-y-3">
                      {destinations.map((d) => (
                        <div key={d.id} className="p-4 rounded-xl border border-[#E9D8BD] flex items-center justify-between text-xs">
                          <div>
                            <span className="text-[10px] text-[#8B4A2B] font-bold uppercase">{d.category}</span>
                            <h4 className="font-bold text-[#173D2B] text-sm">{d.name}</h4>
                            <p className="text-gray-500">{d.address}</p>
                          </div>
                          <div className="space-x-2">
                            <a href={d.googleMapsUrl} target="_blank" className="text-blue-600 hover:underline font-bold">Maps ↗</a>
                            <button
                              onClick={() => {
                                const updated = destinations.filter(item => item.id !== d.id);
                                setDestinations(updated);
                                localStorage.setItem('sukaregang_destinations_list_v2', JSON.stringify(updated));
                              }}
                              className="text-red-600 hover:underline font-bold"
                            >
                              Hapus
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 5. KELOLA TOUR GUIDE */}
                {adminActiveTab === 'guides' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn">
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Kontak Tour Guide Sukaregang</h3>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                      {guides.map((g) => (
                        <div key={g.id} className="p-4 rounded-2xl border border-[#E9D8BD] flex items-start space-x-3 text-xs">
                          <img src={g.avatar} alt={g.name} className="w-14 h-14 rounded-xl object-cover border" />
                          <div className="flex-1 space-y-1">
                            <h4 className="font-bold text-sm text-[#173D2B]">{g.name} ({g.gender})</h4>
                            <p className="font-bold text-[#8B4A2B]">WA: {g.phone}</p>
                            <p className="text-gray-500">{g.specialty}</p>
                            <button
                              onClick={() => {
                                const newWA = prompt(`Ubah No. WhatsApp ${g.name}:`, g.phone);
                                if (newWA) {
                                  const clean = newWA.replace(/[^0-9]/g, '');
                                  const updated = guides.map(item => item.id === g.id ? { ...item, phone: newWA, waNumber: clean } : item);
                                  setGuides(updated);
                                  localStorage.setItem('sukaregang_guides_list_v2', JSON.stringify(updated));
                                }
                              }}
                              className="text-blue-600 hover:underline font-bold"
                            >
                              Ubah Nomor WA
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 6. KELOLA BOOKING */}
                {adminActiveTab === 'bookings' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn">
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Kelola Jadwal Booking Wisatawan ({bookings.length})</h3>
                    <div className="space-y-3">
                      {bookings.map((b) => (
                        <div key={b.id} className="p-4 rounded-xl border border-[#E9D8BD] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                          <div>
                            <span className="font-bold text-sm text-[#173D2B]">{b.customerName}</span>
                            <span className="text-gray-500 block">Guide: <strong>{b.guideName}</strong> • Tanggal: {b.date} ({b.time}) • {b.people} Orang</span>
                            <span className="text-[11px] text-[#8B4A2B]">📍 {b.destinations}</span>
                          </div>
                          <div className="flex items-center space-x-2">
                            <button
                              onClick={() => {
                                const updated = bookings.map(item => item.id === b.id ? { ...item, status: item.status === 'Terkonfirmasi' ? 'Selesai' : 'Terkonfirmasi' } : item);
                                setBookings(updated);
                                localStorage.setItem('sukaregang_bookings_master', JSON.stringify(updated));
                              }}
                              className="px-3 py-1 bg-emerald-100 text-emerald-800 font-bold rounded-lg"
                            >
                              Status: {b.status}
                            </button>
                            <button
                              onClick={() => {
                                const updated = bookings.filter(item => item.id !== b.id);
                                setBookings(updated);
                                localStorage.setItem('sukaregang_bookings_master', JSON.stringify(updated));
                              }}
                              className="text-red-600 hover:underline font-bold"
                            >
                              Batalkan
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 7. KELOLA KESAN & PESAN */}
                {adminActiveTab === 'reviews' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn">
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Moderasi Kesan & Pesan Wisatawan ({reviews.length})</h3>
                    <div className="space-y-3">
                      {reviews.map((r) => (
                        <div key={r.id} className="p-4 rounded-xl border border-[#E9D8BD] flex items-start justify-between gap-3 text-xs">
                          <div className="space-y-1">
                            <div className="flex items-center space-x-2">
                              <span className="font-bold text-sm text-[#173D2B]">{r.name}</span>
                              <span className="text-gray-500">({r.city})</span>
                              <span className="text-amber-500 font-bold">{'⭐'.repeat(r.rating)}</span>
                            </div>
                            <span className="text-[10px] text-[#8B4A2B] font-semibold">{r.destinationVisited} • {r.date}</span>
                            <p className="italic text-gray-700">"{r.comment}"</p>
                          </div>
                          <button
                            onClick={() => {
                              const updated = reviews.filter(rev => rev.id !== r.id);
                              setReviews(updated);
                              localStorage.setItem('sukaregang_visitor_reviews', JSON.stringify(updated));
                            }}
                            className="text-red-600 hover:underline font-bold flex-shrink-0"
                          >
                            Hapus
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 8. KELOLA GALERI */}
                {adminActiveTab === 'gallery' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn">
                    <div className="flex items-center justify-between">
                      <h3 className="font-serif font-bold text-lg text-[#173D2B]">Kelola Media Galeri ({galleryList.length})</h3>
                      <button
                        onClick={() => {
                          const title = prompt('Judul Media Galeri:');
                          const url = prompt('URL Foto/Gambar:');
                          if (title && url) {
                            const updated = [...galleryList, { id: 'gal-' + Date.now(), title, category: 'Foto', url }];
                            setGalleryList(updated);
                            localStorage.setItem('sukaregang_gallery_master', JSON.stringify(updated));
                          }
                        }}
                        className="px-4 py-2 bg-[#173D2B] text-white text-xs font-bold rounded-xl"
                      >
                        + Tambah Foto Galeri
                      </button>
                    </div>

                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
                      {galleryList.map((g) => (
                        <div key={g.id} className="rounded-xl overflow-hidden border border-[#E9D8BD] p-2 bg-gray-50 text-xs">
                          <img src={g.url} alt={g.title} className="w-full h-28 object-cover rounded-lg mb-1.5" />
                          <h5 className="font-bold truncate">{g.title}</h5>
                          <button
                            onClick={() => {
                              const updated = galleryList.filter(item => item.id !== g.id);
                              setGalleryList(updated);
                              localStorage.setItem('sukaregang_gallery_master', JSON.stringify(updated));
                            }}
                            className="text-red-600 text-[10px] hover:underline font-bold mt-1 block"
                          >
                            Hapus Media
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 9. KELOLA SEJARAH */}
                {adminActiveTab === 'history' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn">
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Kelola Artikel & Literasi Sejarah ({articles.length})</h3>
                    <div className="space-y-3 text-xs">
                      {articles.map((a) => (
                        <div key={a.id} className="p-4 rounded-xl border border-[#E9D8BD] flex items-center justify-between">
                          <div>
                            <h4 className="font-bold text-[#173D2B] text-sm">{a.title}</h4>
                            <span className="text-gray-500">{a.author} • {a.date}</span>
                            <p className="text-gray-700 mt-1">{a.snippet}</p>
                          </div>
                          <button
                            onClick={() => {
                              const updated = articles.filter(art => art.id !== a.id);
                              setArticles(updated);
                              localStorage.setItem('sukaregang_articles_master', JSON.stringify(updated));
                            }}
                            className="text-red-600 font-bold hover:underline ml-3"
                          >
                            Hapus
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* KELOLA VIDEO YOUTUBE (TAMBAH VIA LINK YOUTUBE + LIST) */}
                {adminActiveTab === 'videos' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-6 animate-fadeIn">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#ECE3D4]">
                      <div>
                        <h3 className="font-serif font-bold text-xl text-[#173D2B]">
                          Kelola Video Edukasi YouTube ({videos.length})
                        </h3>
                        <p className="text-xs text-gray-500">
                          Tambahkan video edukasi Sukaregang dengan menempelkan tautan link YouTube.
                        </p>
                      </div>
                      <span className="text-xs px-3 py-1 bg-red-100 text-red-700 font-bold rounded-full">
                        ▶️ YouTube Sync
                      </span>
                    </div>

                    {/* Form Tambah Video Baru */}
                    <form
                      onSubmit={(e) => {
                        e.preventDefault();
                        if (!newVidUrl.trim() || !newVidTitle.trim()) {
                          alert('Mohon isi Judul dan Link YouTube.');
                          return;
                        }
                        const extractedId = extractYoutubeId(newVidUrl);
                        if (!extractedId) {
                          alert('Link YouTube tidak valid. Mohon periksa kembali tautan Anda.');
                          return;
                        }
                        const newEntry = {
                          id: 'vid-' + Date.now(),
                          title: newVidTitle.trim(),
                          category: newVidCategory || 'Dokumenter Sukaregang',
                          youtubeUrl: newVidUrl.trim(),
                          youtubeId: extractedId,
                          description: newVidDesc.trim() || 'Video edukasi industri kulit Sukaregang Garut.',
                          duration: 'Video Edukasi'
                        };
                        const updated = [newEntry, ...videos];
                        setVideos(updated);
                        try {
                          localStorage.setItem('sukaregang_videos_list_v2', JSON.stringify(updated));
                        } catch (err) {}
                        setNewVidTitle('');
                        setNewVidUrl('');
                        setNewVidDesc('');
                        alert('Video YouTube berhasil ditambahkan ke aplikasi!');
                      }}
                      className="p-5 rounded-2xl bg-[#F8F4EC] border-2 border-[#E9D8BD] space-y-4 text-xs"
                    >
                      <h4 className="font-serif font-bold text-sm text-[#173D2B] flex items-center space-x-2">
                        <span>➕</span>
                        <span>Tambah Video YouTube Baru</span>
                      </h4>

                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                          <label className="font-bold text-[#173D2B] block mb-1">Judul Video:</label>
                          <input
                            type="text"
                            required
                            value={newVidTitle}
                            onChange={(e) => setNewVidTitle(e.target.value)}
                            placeholder="Contoh: Proses Penyamakan Kulit Alami di Sukaregang"
                            className="w-full p-2.5 rounded-xl border border-[#E9D8BD] bg-white text-xs"
                          />
                        </div>

                        <div>
                          <label className="font-bold text-[#173D2B] block mb-1">Link YouTube (URL):</label>
                          <input
                            type="text"
                            required
                            value={newVidUrl}
                            onChange={(e) => setNewVidUrl(e.target.value)}
                            placeholder="Contoh: https://youtu.be/ARxTWs7Y9Lg atau https://youtube.com/watch?v=..."
                            className="w-full p-2.5 rounded-xl border border-[#E9D8BD] bg-white text-xs"
                          />
                        </div>
                      </div>

                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                          <label className="font-bold text-[#173D2B] block mb-1">Kategori Video:</label>
                          <select
                            value={newVidCategory}
                            onChange={(e) => setNewVidCategory(e.target.value)}
                            className="w-full p-2.5 rounded-xl border border-[#E9D8BD] bg-white text-xs"
                          >
                            <option value="Sejarah Garut">Sejarah Garut</option>
                            <option value="Teknik Pembuatan Sepatu">Teknik Pembuatan Sepatu</option>
                            <option value="Teknik Jaket Kulit">Teknik Jaket Kulit</option>
                            <option value="Proses Bahan Dasar">Proses Bahan Dasar</option>
                            <option value="Wisata Belanja">Wisata Belanja</option>
                            <option value="Perawatan Kulit">Perawatan Kulit</option>
                          </select>
                        </div>

                        <div>
                          <label className="font-bold text-[#173D2B] block mb-1">Deskripsi Singkat:</label>
                          <input
                            type="text"
                            value={newVidDesc}
                            onChange={(e) => setNewVidDesc(e.target.value)}
                            placeholder="Deskripsi singkat konten video..."
                            className="w-full p-2.5 rounded-xl border border-[#E9D8BD] bg-white text-xs"
                          />
                        </div>
                      </div>

                      <button
                        type="submit"
                        className="px-6 py-2.5 bg-[#173D2B] hover:bg-[#102B1E] text-white font-bold text-xs rounded-xl shadow transition"
                      >
                        ➕ Simpan Video ke Aplikasi
                      </button>
                    </form>

                    {/* Daftar Video Terpasang */}
                    <div className="space-y-3">
                      <h4 className="font-serif font-bold text-sm text-[#173D2B]">
                        Daftar Video Aktif ({videos.length}):
                      </h4>
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {videos.map((vid) => (
                          <div
                            key={vid.id}
                            className="p-4 rounded-2xl border border-[#E9D8BD] bg-white flex space-x-3 items-center shadow-sm"
                          >
                            <img
                              src={`https://img.youtube.com/vi/${vid.youtubeId}/hqdefault.jpg`}
                              alt={vid.title}
                              className="w-24 h-16 object-cover rounded-xl border"
                            />
                            <div className="flex-1 min-w-0">
                              <span className="text-[10px] text-[#8B4A2B] font-bold uppercase block truncate">
                                {vid.category}
                              </span>
                              <h5 className="font-bold text-xs text-[#173D2B] truncate">{vid.title}</h5>
                              <a
                                href={vid.youtubeUrl || `https://www.youtube.com/watch?v=${vid.youtubeId}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                className="text-[10px] text-blue-600 hover:underline block truncate mt-0.5"
                              >
                                {vid.youtubeUrl || `youtube.com/watch?v=${vid.youtubeId}`} ↗
                              </a>
                            </div>
                            <button
                              onClick={() => {
                                if (confirm(`Hapus video "${vid.title}"?`)) {
                                  const updated = videos.filter((v) => v.id !== vid.id);
                                  setVideos(updated);
                                  localStorage.setItem('sukaregang_videos_list_v2', JSON.stringify(updated));
                                }
                              }}
                              className="p-2 text-red-600 hover:bg-red-50 rounded-lg text-xs font-bold"
                              title="Hapus Video"
                            >
                              ✕
                            </button>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}
                {adminActiveTab === 'game' && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn">
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Pengaturan Game Simulator 3D (Leather Craft Adventure)</h3>
                    <div className="p-4 bg-[#F8F4EC] rounded-xl space-y-3 text-xs">
                      <div>
                        <label className="font-bold block">Reward Koin Dasar per Level Selesai:</label>
                        <input type="number" defaultValue={25} className="p-2 border rounded-lg bg-white" />
                      </div>
                      <div>
                        <label className="font-bold block">Bahan Kulit Domba Sukaregang Terverifikasi:</label>
                        <span className="text-emerald-700 font-bold">✓ Grade A Export Quality (Aktif)</span>
                      </div>
                      <button
                        onClick={() => alert('Pengaturan game berhasil diperbarui!')}
                        className="px-4 py-2 bg-[#173D2B] text-white font-bold rounded-xl"
                      >
                        Simpan Pengaturan Game
                      </button>
                    </div>
                  </div>
                )}

                {/* 11 & 12: LAPORAN & PENGATURAN */}
                {(adminActiveTab === 'reports' || adminActiveTab === 'settings') && (
                  <div className="bg-white p-6 rounded-2xl border border-[#E9D8BD] shadow-sm space-y-4 animate-fadeIn text-xs">
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Cadangan Sistem & Reset Database</h3>
                    <p className="text-gray-600">Unduh seluruh berkas JSON data lengkap atau kembalikan ke setelan default awal.</p>
                    <div className="flex gap-3 pt-2">
                      <button
                        onClick={() => {
                          const backup = { products, destinations, videos, guides, reviews, usersList, bookings, articles, galleryList };
                          const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
                          const url = URL.createObjectURL(blob);
                          const a = document.createElement('a');
                          a.href = url;
                          a.download = 'sukaregang_master_backup.json';
                          a.click();
                        }}
                        className="px-5 py-2.5 bg-[#173D2B] text-white font-bold rounded-xl shadow"
                      >
                        📥 Unduh Backup Lengkap (JSON)
                      </button>
                      <button
                        onClick={() => {
                          if (!confirm('Peringatan: Reset semua database ke setelan awal pabrik?')) return;
                          localStorage.clear();
                          setProducts(DEFAULT_PRODUCTS);
                          setDestinations(DEFAULT_TOUR_DESTINATIONS);
                          setVideos(DEFAULT_VIDEOS);
                          setGuides(DEFAULT_TOUR_GUIDES);
                          setReviews(DEFAULT_REVIEWS);
                          setUsersList(DEFAULT_USERS);
                          setBookings(DEFAULT_BOOKINGS);
                          alert('Database berhasil di-reset.');
                        }}
                        className="px-5 py-2.5 bg-red-600 text-white font-bold rounded-xl shadow"
                      >
                        ⚠️ Reset ke Default Pabrik
                      </button>
                    </div>
                  </div>
                )}

              </main>
            </div>
          </div>
        );
      }

      // =========================================================================
      // RENDER: WEBSITE UTAMA (USER VIEW)
      // =========================================================================
      return (
        <div className="min-h-screen bg-[#F8F4EC] flex flex-col font-sans">
          
          {/* =================================================================
              TOP APP BAR NAVBAR (RESMI DENGAN LOGO DI POJOK KIRI ATAS)
          ================================================================= */}
          <header className="sticky top-0 z-40 app-glass text-[#F8F4EC] border-b border-[#E9D8BD]/30 shadow-md">
            <div className="max-w-7xl mx-auto px-4 h-16 sm:h-20 flex items-center justify-between">
              
              {/* Brand Logo di Kiri Atas */}
              <button
                onClick={() => setCurrentRoute('beranda')}
                className="flex items-center space-x-3 text-left group"
              >
                <img
                  src="./logo.png"
                  alt="Sukaregang Discovery Logo"
                  className="w-10 h-10 sm:w-12 sm:h-12 object-contain group-hover:scale-105 transition"
                  onError={(e) => {
                    e.target.onerror = null;
                    e.target.src = "https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=120&q=80";
                  }}
                />
                <div>
                  <div className="flex items-center space-x-2">
                    <span className="font-serif text-lg sm:text-xl font-bold tracking-tight text-[#F8F4EC]">
                      SUKAREGANG <span className="text-[#E9D8BD] font-light italic">DISCOVERY</span>
                    </span>
                    <span className="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[9px] font-bold border border-emerald-500/30">
                      LIVE
                    </span>
                  </div>
                  <p className="text-[9px] sm:text-[10px] tracking-wider uppercase text-[#E9D8BD]/80 truncate">
                    Sentra Kerajinan Kulit Garut
                  </p>
                </div>
              </button>

              {/* Desktop Navbar Menu Sesuai Permintaan: Beranda, Explore, Sejarah, Galeri, Game Simulator, Login */}
              <nav className="hidden lg:flex items-center space-x-1 text-xs font-semibold">
                {[
                  { id: 'beranda', label: 'Beranda' },
                  { id: 'explore', label: 'Explore' },
                  { id: 'sejarah', label: 'Sejarah' },
                  { id: 'galeri', label: 'Galeri' },
                  { id: 'simulator', label: '🎮 Game Simulator' },
                  { id: 'reviews', label: 'Kesan & Pesan' },
                ].map((tab) => (
                  <button
                    key={tab.id}
                    onClick={() => setCurrentRoute(tab.id)}
                    className={`px-3.5 py-2 rounded-xl transition ${
                      currentRoute === tab.id
                        ? 'bg-[#E9D8BD] text-[#173D2B] font-bold shadow'
                        : 'text-[#F8F4EC]/90 hover:bg-[#102B1E] hover:text-[#E9D8BD]'
                    }`}
                  >
                    {tab.label}
                  </button>
                ))}
              </nav>

              {/* Tombol Login / Profil & Portal Admin */}
              <div className="flex items-center space-x-2">
                <button
                  onClick={() => setCurrentRoute('admin_dashboard')}
                  className="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-[#8B4A2B]/40 hover:bg-[#8B4A2B] text-[#E9D8BD] hover:text-white border border-[#E9D8BD]/40 text-xs font-bold transition shadow"
                  title="Masuk ke Dashboard Admin Full Screen"
                >
                  <Icon name="shield-check" className="w-3.5 h-3.5" />
                  <span>Admin</span>
                </button>

                {currentUser ? (
                  <button
                    onClick={() => setIsProfileModalOpen(true)}
                    className="flex items-center space-x-2 p-1.5 pr-3 rounded-full bg-[#102B1E] border border-[#E9D8BD]/40 hover:border-[#E9D8BD] transition shadow"
                  >
                    <img
                      src={currentUser.avatarUrl || './logo.png'}
                      alt={currentUser.name}
                      className="w-8 h-8 rounded-full object-contain border border-[#E9D8BD] bg-[#173D2B] p-0.5"
                    />
                    <div className="text-left text-xs leading-tight hidden sm:block">
                      <span className="font-bold text-[#F8F4EC] block truncate max-w-[110px]">
                        {currentUser.name.split(' ')[0]}
                      </span>
                      <span className="text-[10px] text-emerald-400 block truncate max-w-[110px]">
                        {currentUser.role === 'admin' ? '👑 Admin' : 'Wisatawan'}
                      </span>
                    </div>
                  </button>
                ) : (
                  <button
                    onClick={() => setCurrentRoute('login')}
                    className="px-4 py-2 rounded-xl bg-[#E9D8BD] hover:bg-[#D6B889] text-[#173D2B] text-xs font-bold transition shadow flex items-center space-x-1.5"
                  >
                    <Icon name="log-in" className="w-3.5 h-3.5" />
                    <span>Login</span>
                  </button>
                )}

                {/* Mobile Hamburger Button */}
                <button
                  onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}
                  className="lg:hidden p-2 rounded-xl bg-white/10 hover:bg-white/20 text-[#E9D8BD]"
                >
                  <Icon name={isMobileMenuOpen ? "x" : "menu"} className="w-5 h-5" />
                </button>
              </div>
            </div>

            {/* Mobile Navigation Drawer */}
            {isMobileMenuOpen && (
              <div className="lg:hidden bg-[#102B1E] border-t border-[#E9D8BD]/30 p-4 space-y-2 text-xs font-bold animate-fadeIn">
                {[
                  { id: 'beranda', label: '🏠 Beranda' },
                  { id: 'explore', label: '🗺️ Explore Peta & Pabrik' },
                  { id: 'sejarah', label: '📜 Sejarah Garut' },
                  { id: 'galeri', label: '🛍️ Galeri Syakira Store' },
                  { id: 'simulator', label: '🎮 Game Simulator 3D' },
                  { id: 'reviews', label: '💬 Kesan & Pesan' },
                ].map((item) => (
                  <button
                    key={item.id}
                    onClick={() => {
                      setCurrentRoute(item.id);
                      setIsMobileMenuOpen(false);
                    }}
                    className={`w-full text-left px-3 py-2.5 rounded-xl transition ${
                      currentRoute === item.id ? 'bg-[#E9D8BD] text-[#173D2B]' : 'text-white hover:bg-white/10'
                    }`}
                  >
                    {item.label}
                  </button>
                ))}
                {!currentUser && (
                  <button
                    onClick={() => {
                      setCurrentRoute('login');
                      setIsMobileMenuOpen(false);
                    }}
                    className="w-full text-left px-3 py-2.5 rounded-xl bg-[#E9D8BD] text-[#173D2B] font-bold flex items-center space-x-1.5"
                  >
                    <span>🔐</span>
                    <span>Halaman Login Terpisah</span>
                  </button>
                )}
                <button
                  onClick={() => {
                    setCurrentRoute('admin_dashboard');
                    setIsMobileMenuOpen(false);
                  }}
                  className="w-full text-left px-3 py-2.5 rounded-xl bg-[#8B4A2B] text-white font-bold flex items-center space-x-1.5"
                >
                  <span>⚙️</span>
                  <span>Buka Dashboard Admin Full Screen</span>
                </button>
              </div>
            )}
          </header>

          {/* =================================================================
              MAIN VIEWPORT CONTENT
          ================================================================= */}
          <main className="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6">
            
            {/* -------------------------------------------------------------
                A. LANDING PAGE AWAL (SESUAI KATA-KATA RESMI MASTER REDESIGN)
            ------------------------------------------------------------- */}
            {currentRoute === 'beranda' && (
              <div className="space-y-12 animate-fadeIn">
                
                {/* Hero Section Bersih, Ringkas & Menarik */}
                <div className="relative rounded-3xl overflow-hidden bg-[#173D2B] text-[#F8F4EC] p-6 sm:p-12 lg:p-16 border-2 border-[#E9D8BD]/40 shadow-2xl">
                  <div className="flex flex-col lg:flex-row items-center justify-between gap-8">
                    
                    {/* Visual Character & Logo 3D Box */}
                    <div className="flex-shrink-0 text-center order-first lg:order-last">
                      <div className="relative inline-block group">
                        <img
                          src="./logo.png"
                          alt="Sukaregang Discovery"
                          className="w-40 h-40 sm:w-52 sm:h-52 object-contain drop-shadow-2xl transform group-hover:scale-105 transition duration-500"
                        />
                      </div>
                      <div className="mt-3 px-3 py-1 bg-[#102B1E] rounded-full border border-[#E9D8BD]/30 inline-flex items-center space-x-1.5 text-[11px] text-[#E9D8BD]">
                        <span>🧑‍🎨</span>
                        <span>Pengrajin Asli Sukaregang Garut</span>
                      </div>
                    </div>

                    {/* Teks Hero Resmi Sesuai Prompt */}
                    <div className="flex-1 space-y-4 text-center lg:text-left max-w-2xl">
                      <span className="text-xs uppercase tracking-widest text-[#E9D8BD] font-bold block">
                        Selamat Datang di Sukaregang
                      </span>
                      
                      <p className="text-xs sm:text-sm text-[#E9D8BD]/90 leading-relaxed font-medium">
                        "Mengenal lebih dekat kawasan sentra industri kulit yang menjadi salah satu identitas kerajinan unggulan Garut."
                      </p>

                      <h1 className="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-wide text-white">
                        Discover the Heritage of Leather
                      </h1>

                      <p className="text-xs sm:text-sm text-[#F8F4EC]/85 leading-relaxed font-normal">
                        "Jelajahi cerita, budaya, dan kreativitas para pengrajin kulit Sukaregang. Temukan pengalaman menarik mengenal proses pembuatan produk kulit dari awal hingga menjadi karya berkualitas."
                      </p>

                      {/* Tombol Sesuai Instruksi: Mulai Eksplorasi & Login */}
                      <div className="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-3">
                        <button
                          onClick={() => setCurrentRoute('explore')}
                          className="px-7 py-3.5 bg-[#E9D8BD] hover:bg-[#D6B889] text-[#173D2B] font-bold text-xs rounded-2xl shadow-xl transition flex items-center space-x-2"
                        >
                          <Icon name="compass" className="w-4 h-4" />
                          <span>Mulai Eksplorasi</span>
                        </button>
                        <button
                          onClick={() => setCurrentRoute('login')}
                          className="px-7 py-3.5 bg-[#8B4A2B] hover:bg-[#6E381F] text-white font-bold text-xs rounded-2xl shadow-xl transition flex items-center space-x-2"
                        >
                          <Icon name="log-in" className="w-4 h-4" />
                          <span>Login Akun</span>
                        </button>
                        <button
                          onClick={() => setCurrentRoute('simulator')}
                          className="px-6 py-3.5 bg-[#102B1E] hover:bg-black text-[#E9D8BD] font-bold text-xs rounded-2xl border border-[#E9D8BD]/40 shadow-xl transition flex items-center space-x-2"
                        >
                          <Icon name="gamepad-2" className="w-4 h-4" />
                          <span>🎮 Game Simulator 3D</span>
                        </button>
                      </div>
                    </div>

                  </div>
                </div>

                {/* 3 Kartu Teaser Eksplorasi Bersih & Tidak Terlalu Penuh Tulisan */}
                <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <div
                    onClick={() => setCurrentRoute('explore')}
                    className="cursor-pointer bg-white rounded-3xl p-7 border-2 border-[#E9D8BD]/50 shadow-sm hover:shadow-xl transition space-y-3 group"
                  >
                    <div className="w-12 h-12 rounded-2xl bg-[#173D2B] text-[#E9D8BD] flex items-center justify-center text-xl group-hover:scale-110 transition">
                      🗺️
                    </div>
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Explore Kawasan Pabrik</h3>
                    <p className="text-xs text-[#35251D]/75 leading-relaxed">
                      Peta interaktif titik industri penyamakan, pabrik jaket, dan pusat belanja Piazza Firenze.
                    </p>
                    <span className="text-xs font-bold text-[#8B4A2B] inline-block">Jelajahi Peta →</span>
                  </div>

                  <div
                    onClick={() => setCurrentRoute('sejarah')}
                    className="cursor-pointer bg-white rounded-3xl p-7 border-2 border-[#E9D8BD]/50 shadow-sm hover:shadow-xl transition space-y-3 group"
                  >
                    <div className="w-12 h-12 rounded-2xl bg-[#173D2B] text-[#E9D8BD] flex items-center justify-center text-xl group-hover:scale-110 transition">
                      📜
                    </div>
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Sejarah & Edukasi Kulit</h3>
                    <p className="text-xs text-[#35251D]/75 leading-relaxed">
                      Video dokumenter Garut dan teknik pengolahan kulit domba dari masa ke masa.
                    </p>
                    <span className="text-xs font-bold text-[#8B4A2B] inline-block">Pelajari Ceritanya →</span>
                  </div>

                  <div
                    onClick={() => setCurrentRoute('simulator')}
                    className="cursor-pointer bg-white rounded-3xl p-7 border-2 border-[#8B4A2B]/40 shadow-sm hover:shadow-xl transition space-y-3 group"
                  >
                    <div className="w-12 h-12 rounded-2xl bg-[#8B4A2B] text-white flex items-center justify-center text-xl group-hover:scale-110 transition">
                      🎮
                    </div>
                    <h3 className="font-serif font-bold text-lg text-[#173D2B]">Leather Craft Adventure</h3>
                    <p className="text-xs text-[#35251D]/75 leading-relaxed">
                      Game 3D membuat jaket & sepatu kulit interaktif! Pilih desain, potong pola, dan jahit.
                    </p>
                    <span className="text-xs font-bold text-[#8B4A2B] inline-block">Mulai Petualangan 3D →</span>
                  </div>
                </div>

                {/* Banner Toko Resmi Syakira Leather */}
                <div className="bg-gradient-to-r from-[#8B4A2B] to-[#6E381F] rounded-3xl p-6 text-white shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4 border border-[#E9D8BD]/40">
                  <div className="flex items-center space-x-4">
                    <div className="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-2xl flex-shrink-0">
                      🛍️
                    </div>
                    <div>
                      <h3 className="font-serif font-bold text-base sm:text-lg">Koleksi Asli Syakira Leather Sukaregang</h3>
                      <p className="text-xs text-white/90">
                        20 produk jaket domba asli & sepatu pria/wanita dengan tautan resmi marketplace Shopee.
                      </p>
                    </div>
                  </div>
                  <div className="flex gap-2 flex-shrink-0">
                    <button
                      onClick={() => setCurrentRoute('galeri')}
                      className="px-4 py-2.5 bg-white text-[#173D2B] text-xs font-bold rounded-xl shadow hover:bg-[#F8F4EC] transition"
                    >
                      Buka Galeri Produk
                    </button>
                    <a
                      href={SYAKIRA_OFFICIAL_SHOPEE_STORE}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="px-4 py-2.5 bg-[#173D2B] text-[#E9D8BD] text-xs font-bold rounded-xl shadow hover:bg-[#102B1E] transition flex items-center space-x-1"
                    >
                      <span>Shopee Resmi</span>
                      <span>↗</span>
                    </a>
                  </div>
                </div>

              </div>
            )}

            {/* -------------------------------------------------------------
                D & E. GAME SIMULATOR 3D (LEATHER CRAFT ADVENTURE)
            ------------------------------------------------------------- */}
            {currentRoute === 'simulator' && (
              <div className="space-y-6 animate-fadeIn">
                
                {/* Visual Feedback Banner */}
                {simAudioFeedback && (
                  <div className="p-3 bg-emerald-600 text-white text-xs font-bold rounded-2xl text-center shadow-lg animate-fadeIn flex items-center justify-center space-x-2">
                    <span>✨</span>
                    <span>{simAudioFeedback}</span>
                  </div>
                )}

                {/* MENU AWAL GAME */}
                {simGameMode === 'menu' && (
                  <div className="bg-white rounded-3xl p-8 sm:p-12 border-2 border-[#E9D8BD]/50 shadow-xl space-y-8 text-center max-w-4xl mx-auto">
                    <div className="space-y-3 max-w-2xl mx-auto">
                      <div className="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-[#E9D8BD]/30 border border-[#8B4A2B]/40 text-xs font-bold text-[#8B4A2B]">
                        <span>🎮 Game Edukasi 3D Pengrajin Garut</span>
                      </div>
                      <h2 className="font-serif text-3xl sm:text-4xl font-bold text-[#173D2B]">
                        Leather Craft Adventure
                      </h2>
                      <p className="text-xs sm:text-sm text-[#35251D]/80 leading-relaxed">
                        "Yuk, belajar menjadi pengrajin kulit Sukaregang! Buat jaket dan sepatu sendiri dari bahan mentah hingga menjadi produk siap digunakan."
                      </p>
                    </div>

                    {/* Dua Pilihan Game dengan Gambar 3D & Tombol Mainkan */}
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
                      {/* 1. Membuat Jaket Kulit */}
                      <div className="p-6 rounded-3xl bg-[#F8F4EC] border-2 border-[#E9D8BD] hover:border-[#8B4A2B] hover:shadow-xl transition space-y-4 flex flex-col justify-between group">
                        <div className="space-y-3">
                          <div className="h-64 sm:h-72 rounded-3xl overflow-hidden bg-white border-2 border-[#E9D8BD] shadow-inner">
                            <ThreeLeatherViewer craftType="jaket" color="#1a1a1a" modelType="Biker" />
                          </div>
                          <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wider block">Workshop 1</span>
                          <h3 className="font-serif text-xl font-bold text-[#173D2B]">🧥 Membuat Jaket Kulit Domba</h3>
                          <p className="text-xs text-[#35251D]/75 leading-relaxed">
                            Pilih model Biker, Bomber, Jangkis, atau Jubah. Potong pola dengan pisau khusus, jahit dengan mesin jarum tebal, dan pasang ritsleting kuningan YKK.
                          </p>
                        </div>
                        <button
                          onClick={() => {
                            setSimGameMode('jaket');
                            setSimLevel(1);
                            setSimScore(100);
                          }}
                          className="w-full py-3 bg-[#173D2B] hover:bg-[#102B1E] text-white font-bold text-xs rounded-xl shadow transition text-center"
                        >
                          Mainkan Jaket Kulit 3D →
                        </button>
                      </div>

                      {/* 2. Membuat Sepatu Kulit */}
                      <div className="p-6 rounded-3xl bg-[#F8F4EC] border-2 border-[#E9D8BD] hover:border-[#8B4A2B] hover:shadow-xl transition space-y-4 flex flex-col justify-between group">
                        <div className="space-y-3">
                          <div className="h-64 sm:h-72 rounded-3xl overflow-hidden bg-white border-2 border-[#E9D8BD] shadow-inner">
                            <ThreeLeatherViewer craftType="sepatu" color="#5a3319" modelType="Boots" />
                          </div>
                          <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wider block">Workshop 2</span>
                          <h3 className="font-serif text-xl font-bold text-[#173D2B]">👞 Membuat Sepatu Kulit Sapi</h3>
                          <p className="text-xs text-[#35251D]/75 leading-relaxed">
                            Pilih model Boots, Oxford, Pantofel, atau Ankle Boots. Potong Vamp & Tongue, lakukan shoe lasting, pasang insole empuk, dan jahit sol tembus.
                          </p>
                        </div>
                        <button
                          onClick={() => {
                            setSimGameMode('sepatu');
                            setSimLevel(1);
                            setSimScore(100);
                          }}
                          className="w-full py-3 bg-[#8B4A2B] hover:bg-[#6E381F] text-white font-bold text-xs rounded-xl shadow transition text-center"
                        >
                          Mainkan Sepatu Kulit 3D →
                        </button>
                      </div>
                    </div>
                  </div>
                )}

                {/* GAME WORKSHOP JAKET 3D (7 LEVEL LENGKAP) */}
                {simGameMode === 'jaket' && (
                  <div className="bg-white rounded-3xl p-6 sm:p-10 border-2 border-[#E9D8BD]/50 shadow-xl space-y-6">
                    {/* Header Level & Progress Bar */}
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#ECE3D4]">
                      <div>
                        <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wider">Level {simLevel} dari 7</span>
                        <h3 className="font-serif text-2xl font-bold text-[#173D2B]">
                          Workshop Jaket Kulit: {
                            simLevel === 1 ? 'Memilih Desain & Model 3D' :
                            simLevel === 2 ? 'Memilih Bahan Kulit Mentah' :
                            simLevel === 3 ? 'Memotong Pola (Cutting Mini-game)' :
                            simLevel === 4 ? 'Menjahit di Mesin Jahit 3D' :
                            simLevel === 5 ? 'Merakit Jaket (Drag & Drop)' :
                            simLevel === 6 ? 'Finishing & Semir Alami' : 'Hasil Akhir Jaket 3D & Sertifikat'
                          }
                        </h3>
                      </div>
                      <div className="flex items-center space-x-3 text-xs font-bold">
                        <span className="px-3 py-1 bg-amber-100 text-amber-800 rounded-full">🪙 {simCoins} Koin</span>
                        <span className="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full">⭐ Skor: {simScore}/100</span>
                        <button
                          onClick={() => setSimGameMode('menu')}
                          className="px-3 py-1 bg-gray-100 hover:bg-gray-200 rounded-full text-gray-700"
                        >
                          Menu Game
                        </button>
                      </div>
                    </div>

                    {/* LEVEL 1 – MEMILIH DESAIN & INTERACTIVE 3D ROTATE */}
                    {simLevel === 1 && (
                      <div className="space-y-6">
                        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
                          <div className="h-80 sm:h-96 w-full rounded-3xl overflow-hidden shadow-xl border-2 border-[#E9D8BD]">
                            <ThreeLeatherViewer craftType="jaket" color={jaketColor} modelType={jaketDesign} />
                          </div>
                          <div className="space-y-4 text-xs">
                            <div>
                              <label className="font-bold block mb-1 text-[#173D2B]">Model Siluet Jaket:</label>
                              <div className="grid grid-cols-2 gap-2">
                                {['Jaket Biker', 'Jaket Bomber', 'Jaket Jangkis', 'Jaket Jubah'].map((d) => (
                                  <button
                                    key={d}
                                    type="button"
                                    onClick={() => { setJaketDesign(d); triggerEffect(`Model diubah ke ${d}`); }}
                                    className={`p-2.5 rounded-xl border text-left font-bold transition ${
                                      jaketDesign === d ? 'bg-[#173D2B] text-white border-[#173D2B]' : 'bg-[#F8F4EC] border-[#E9D8BD]'
                                    }`}
                                  >
                                    {d}
                                  </button>
                                ))}
                              </div>
                            </div>

                            <div>
                              <label className="font-bold block mb-1 text-[#173D2B]">Warna Kulit Domba Asli:</label>
                              <div className="flex flex-wrap gap-2">
                                {['Hitam Obsidian', 'Cokelat Heritage', 'Tan Cognac'].map((c) => (
                                  <button
                                    key={c}
                                    type="button"
                                    onClick={() => { setJaketColor(c); triggerEffect(`Warna diubah ke ${c}`); }}
                                    className={`px-3 py-1.5 rounded-xl border font-bold text-xs ${
                                      jaketColor === c ? 'bg-[#8B4A2B] text-white border-[#8B4A2B]' : 'bg-white border-gray-300'
                                    }`}
                                  >
                                    {c}
                                  </button>
                                ))}
                              </div>
                            </div>

                            <div>
                              <label className="font-bold block mb-1 text-[#173D2B]">Model Kerah & Resleting:</label>
                              <div className="flex gap-2">
                                <span className="px-2.5 py-1 bg-[#E9D8BD]/50 rounded-lg font-semibold">{jaketCollar}</span>
                                <span className="px-2.5 py-1 bg-[#E9D8BD]/50 rounded-lg font-semibold">{jaketZipper}</span>
                              </div>
                            </div>
                          </div>
                        </div>

                        <button
                          onClick={() => setSimLevel(2)}
                          className="w-full py-3 bg-[#173D2B] text-white font-bold text-xs rounded-xl shadow-lg hover:bg-[#102B1E] transition"
                        >
                          Lanjut Level 2: Memilih Lembaran Bahan Kulit →
                        </button>
                      </div>
                    )}

                    {/* LEVEL 2 – MEMILIH BAHAN KULIT */}
                    {simLevel === 2 && (
                      <div className="space-y-6">
                        <div className="p-4 bg-[#F8F4EC] rounded-2xl border border-[#E9D8BD] text-xs">
                          <h4 className="font-bold text-[#173D2B] mb-1">Meja Workshop Pengrajin:</h4>
                          <p className="text-gray-700">Pilih jenis bahan yang paling tepat untuk pembuatan jaket kasual fleksibel:</p>
                        </div>

                        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                          {[
                            { name: 'Kulit Domba Garut Grade A', desc: 'Pori rapat, lembut, elastis, dan sejuk di badan.', isCorrect: true },
                            { name: 'Kulit Sapi Keras Kering', desc: 'Tebal dan kaku, kurang nyaman untuk jaket harian.', isCorrect: false },
                            { name: 'Kulit Sintetis Imitasi', desc: 'Mudah sobek, panas di badan, bukan kulit asli.', isCorrect: false },
                          ].map((b) => (
                            <div
                              key={b.name}
                              onClick={() => {
                                if (b.isCorrect) {
                                  triggerEffect('Hebat! Kulit Domba Garut adalah pilihan terbaik!');
                                  setSimCoins(simCoins + 25);
                                  setTimeout(() => setSimLevel(3), 800);
                                } else {
                                  alert('Kurang tepat! Jaket kulit kualitas Garut memakai Kulit Domba Asli yang lentur.');
                                  setSimScore(Math.max(70, simScore - 10));
                                }
                              }}
                              className="cursor-pointer p-5 rounded-2xl border-2 border-[#E9D8BD] hover:border-[#8B4A2B] hover:shadow-lg transition bg-white space-y-2"
                            >
                              <span className="text-2xl block">{b.isCorrect ? '🐑' : '❌'}</span>
                              <h4 className="font-serif font-bold text-sm text-[#173D2B]">{b.name}</h4>
                              <p className="text-gray-600">{b.desc}</p>
                              <span className="text-[10px] font-bold text-[#8B4A2B] block">Pilih Bahan Ini →</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* LEVEL 3 – MEMOTONG POLA (CUTTING MINI-GAME) */}
                    {simLevel === 3 && (
                      <div className="space-y-6">
                        <div className="p-4 bg-[#F8F4EC] rounded-2xl border border-[#E9D8BD] text-xs">
                          <h4 className="font-bold text-[#173D2B] mb-1">Aktivitas Memotong Pola Kulit (Pattern Cutting):</h4>
                          <p className="text-gray-700">Klik / geser pisau potong pada setiap bagian pola di bawah ini untuk memotongnya secara presisi!</p>
                        </div>

                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs text-center">
                          {[
                            { key: 'depan', label: '1. Pola Badan Depan', icon: '✂️' },
                            { key: 'belakang', label: '2. Pola Punggung Belakang', icon: '✂️' },
                            { key: 'lengan', label: '3. Pola Lengan & Siku', icon: '✂️' },
                            { key: 'kerah', label: '4. Pola Kerah & Saku', icon: '✂️' },
                          ].map((p) => {
                            const isDone = jaketCutParts[p.key];
                            return (
                              <div
                                key={p.key}
                                onClick={() => {
                                  setJaketCutParts(prev => ({ ...prev, [p.key]: true }));
                                  triggerEffect(`Pola ${p.label} terpotong sempurna!`);
                                }}
                                className={`cursor-pointer p-6 rounded-2xl border-2 transition space-y-2 ${
                                  isDone ? 'bg-emerald-50 border-emerald-500 text-emerald-900' : 'bg-white border-[#E9D8BD] hover:border-[#8B4A2B]'
                                }`}
                              >
                                <span className="text-3xl block">{isDone ? '✓' : p.icon}</span>
                                <h4 className="font-serif font-bold text-xs">{p.label}</h4>
                                <span className={`text-[10px] px-2 py-0.5 rounded-full font-bold ${isDone ? 'bg-emerald-200 text-emerald-800' : 'bg-gray-200'}`}>
                                  {isDone ? 'Terpotong Presisi' : 'Sentuh untuk Potong'}
                                </span>
                              </div>
                            );
                          })}
                        </div>

                        <div className="flex items-center justify-between pt-2">
                          <span className="text-xs font-bold text-[#173D2B]">
                            Progress: {Object.values(jaketCutParts).filter(Boolean).length} / 4 Pola
                          </span>
                          <button
                            disabled={!Object.values(jaketCutParts).every(Boolean)}
                            onClick={() => setSimLevel(4)}
                            className="px-6 py-3 bg-[#173D2B] disabled:bg-gray-300 text-white font-bold text-xs rounded-xl shadow"
                          >
                            Lanjut Level 4: Menjahit di Mesin Jahit 3D →
                          </button>
                        </div>
                      </div>
                    )}

                    {/* LEVEL 4 – MENJAHIT (MESIN JAHIT 3D) */}
                    {simLevel === 4 && (
                      <div className="space-y-6 text-center">
                        <div className="p-4 bg-[#F8F4EC] rounded-2xl border border-[#E9D8BD] text-xs text-left">
                          <h4 className="font-bold text-[#173D2B] mb-1">Mesin Jahit Kulit Sukaregang:</h4>
                          <p className="text-gray-700">Tahan pedal jahit di bawah ini untuk menggerakkan jarum jahit kulit benang nilon no. 30!</p>
                        </div>

                        <div className="p-8 bg-gradient-to-b from-gray-100 to-gray-200 rounded-3xl border-2 border-gray-300 max-w-md mx-auto space-y-4">
                          <div className={`text-5xl ${isSewingActive ? 'sewing-pulse' : ''}`}>
                            🪡
                          </div>
                          <div className="w-full h-4 bg-gray-300 rounded-full overflow-hidden border">
                            <div className="h-full bg-emerald-600 transition-all duration-200" style={{ width: `${sewingProgress}%` }}></div>
                          </div>
                          <span className="text-xs font-bold text-[#173D2B] block">Jahitan: {sewingProgress}% Selesai</span>
                          
                          <button
                            onMouseDown={() => {
                              setIsSewingActive(true);
                              const interval = setInterval(() => {
                                setSewingProgress(prev => {
                                  if (prev >= 100) {
                                    clearInterval(interval);
                                    setIsSewingActive(false);
                                    triggerEffect('Jahitan ganda rapi & kuat selesai!');
                                    return 100;
                                  }
                                  return prev + 10;
                                });
                              }, 150);
                            }}
                            onTouchStart={() => {
                              setIsSewingActive(true);
                              const interval = setInterval(() => {
                                setSewingProgress(prev => {
                                  if (prev >= 100) {
                                    clearInterval(interval);
                                    setIsSewingActive(false);
                                    triggerEffect('Jahitan ganda rapi & kuat selesai!');
                                    return 100;
                                  }
                                  return prev + 10;
                                });
                              }, 150);
                            }}
                            className="px-8 py-4 bg-[#8B4A2B] hover:bg-[#6E381F] text-white text-xs font-bold rounded-2xl shadow-xl active:scale-95 transition"
                          >
                            {sewingProgress >= 100 ? '✓ Jahitan 100% Selesai' : '🧵 Tekan & Tahan Pedal Jahit'}
                          </button>
                        </div>

                        {sewingProgress >= 100 && (
                          <button
                            onClick={() => setSimLevel(5)}
                            className="px-6 py-3 bg-[#173D2B] text-white font-bold text-xs rounded-xl shadow-lg"
                          >
                            Lanjut Level 5: Merakit Komponen Jaket →
                          </button>
                        )}
                      </div>
                    )}

                    {/* LEVEL 5 – MERAKIT JAKET (ASSEMBLY) */}
                    {simLevel === 5 && (
                      <div className="space-y-6">
                        <div className="p-4 bg-[#F8F4EC] rounded-2xl border border-[#E9D8BD] text-xs">
                          <h4 className="font-bold text-[#173D2B] mb-1">Perakitan Jaket (Drag & Drop Component):</h4>
                          <p className="text-gray-700">Pasang setiap komponen pada manekin jaket untuk menyatukan jaket utuh:</p>
                        </div>

                        <div className="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
                          {[
                            { key: 'depan', label: '1. Pasang Panel Depan' },
                            { key: 'belakang', label: '2. Pasang Panel Belakang' },
                            { key: 'lengan', label: '3. Pasang Lengan Kiri-Kanan' },
                            { key: 'kerah', label: '4. Pasang Kerah Snap' },
                            { key: 'zipper', label: '5. Pasang Zipper YKK Logam' },
                            { key: 'furing', label: '6. Pasang Furing Dormeuil' },
                          ].map((item) => {
                            const isAttached = assembledParts[item.key];
                            return (
                              <button
                                key={item.key}
                                type="button"
                                onClick={() => {
                                  setAssembledParts(prev => ({ ...prev, [item.key]: true }));
                                  triggerEffect(`${item.label} berhasil terpasang!`);
                                }}
                                className={`p-4 rounded-xl border text-left font-bold transition flex items-center justify-between ${
                                  isAttached ? 'bg-emerald-50 border-emerald-500 text-emerald-800' : 'bg-white border-[#E9D8BD] hover:border-[#8B4A2B]'
                                }`}
                              >
                                <span>{item.label}</span>
                                <span>{isAttached ? '✓' : '+ Pasang'}</span>
                              </button>
                            );
                          })}
                        </div>

                        <div className="flex items-center justify-between pt-2">
                          <span className="text-xs font-bold text-[#173D2B]">
                            Tergabung: {Object.values(assembledParts).filter(Boolean).length} / 6 Komponen
                          </span>
                          <button
                            disabled={!Object.values(assembledParts).every(Boolean)}
                            onClick={() => setSimLevel(6)}
                            className="px-6 py-3 bg-[#173D2B] disabled:bg-gray-300 text-white font-bold text-xs rounded-xl shadow"
                          >
                            Lanjut Level 6: Finishing & Semir Alami →
                          </button>
                        </div>
                      </div>
                    )}

                    {/* LEVEL 6 – FINISHING */}
                    {simLevel === 6 && (
                      <div className="space-y-6 text-center">
                        <div className="p-4 bg-[#F8F4EC] rounded-2xl border border-[#E9D8BD] text-xs text-left">
                          <h4 className="font-bold text-[#173D2B] mb-1">Perawatan & QC Akhir Pengrajin:</h4>
                          <p className="text-gray-700">Lakukan pembersihan dan poles minyak mink alami agar kulit awet puluhan tahun:</p>
                        </div>

                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl mx-auto text-xs">
                          <button
                            onClick={() => { setCleanPassed(true); triggerEffect('Debu workshop bersih!'); }}
                            className={`p-6 rounded-2xl border-2 transition font-bold ${cleanPassed ? 'bg-emerald-50 border-emerald-500 text-emerald-800' : 'bg-white border-[#E9D8BD]'}`}
                          >
                            <span className="text-3xl block mb-2">🧽</span>
                            <span>{cleanPassed ? '✓ Permukaan Bersih Terawat' : '1. Bersihkan Permukaan Kulit'}</span>
                          </button>
                          <button
                            onClick={() => { setMinkOilApplied(true); triggerEffect('Mink oil meresap, kilau mewah satin keluar!'); }}
                            className={`p-6 rounded-2xl border-2 transition font-bold ${minkOilApplied ? 'bg-emerald-50 border-emerald-500 text-emerald-800' : 'bg-white border-[#E9D8BD]'}`}
                          >
                            <span className="text-3xl block mb-2">✨</span>
                            <span>{minkOilApplied ? '✓ Minyak Mink Alami Meresap' : '2. Oleskan Semir Mink Oil'}</span>
                          </button>
                        </div>

                        {cleanPassed && minkOilApplied && (
                          <button
                            onClick={() => setSimLevel(7)}
                            className="px-8 py-3.5 bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xl hover:bg-emerald-800 transition"
                          >
                            🎉 Buka Hasil Akhir Jaket 3D & Dapatkan Sertifikat! →
                          </button>
                        )}
                      </div>
                    )}

                    {/* LEVEL 7 – HASIL AKHIR 3D & SERTIFIKAT */}
                    {simLevel === 7 && (
                      <div className="space-y-6 text-center animate-fadeIn">
                        <div className="max-w-2xl mx-auto space-y-3">
                          <span className="text-xs font-bold uppercase tracking-widest text-[#8B4A2B]">Level 7 Selesai</span>
                          <h3 className="font-serif text-3xl font-bold text-[#173D2B]">
                            {jaketDesign} ({jaketColor}) Berhasil Diciptakan!
                          </h3>
                          <p className="text-xs text-gray-600">
                            Puter dan lihat detail karya 3D kamu dari segala sudut dengan sentuhan jari atau mouse:
                          </p>
                        </div>

                        {/* Interactive 3D Canvas Result */}
                        <div className="h-80 w-full max-w-xl mx-auto shadow-2xl rounded-3xl overflow-hidden border-2 border-[#E9D8BD]">
                          <ThreeLeatherViewer craftType="jaket" color={jaketColor} modelType={jaketDesign} />
                        </div>

                        {/* Sertifikat Digital Pengrajin */}
                        <div className="p-6 bg-gradient-to-r from-[#173D2B] to-[#102B1E] text-[#F8F4EC] rounded-3xl max-w-xl mx-auto border-4 border-[#E9D8BD] shadow-2xl space-y-3">
                          <span className="text-[10px] uppercase font-bold tracking-widest text-[#E9D8BD]">Sertifikat Pengrajin Kulit Sukaregang</span>
                          <h4 className="font-serif text-xl font-bold text-white">MASTER LEATHERCRAFT CERTIFICATE</h4>
                          <p className="text-xs text-[#E9D8BD]">
                            Diberikan kepada: <strong>{currentUser ? currentUser.name : 'Wisatawan Pengrajin Sukaregang'}</strong>
                          </p>
                          <div className="flex justify-around pt-2 text-xs border-t border-white/20">
                            <span>Skor Ketelitian: <strong>{simScore}/100</strong></span>
                            <span>Koin Reward: <strong>+150 Koin</strong></span>
                            <span>Status: <strong>Lulus Standar Garut</strong></span>
                          </div>
                        </div>

                        <div className="flex flex-wrap items-center justify-center gap-3 pt-2">
                          <a
                            href={SYAKIRA_OFFICIAL_SHOPEE_STORE}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="px-6 py-3 bg-[#8B4A2B] hover:bg-[#6E381F] text-white font-bold text-xs rounded-xl shadow-lg transition"
                          >
                            Beli Jaket Kulit Serupa di Shopee Syakira Leather ↗
                          </a>
                          <button
                            onClick={() => {
                              setSimGameMode('menu');
                              setSimLevel(1);
                            }}
                            className="px-5 py-3 bg-gray-100 hover:bg-gray-200 text-[#173D2B] font-bold text-xs rounded-xl shadow"
                          >
                            Pilih Permainan Lain
                          </button>
                        </div>
                      </div>
                    )}

                  </div>
                )}

                {/* GAME WORKSHOP SEPATU 3D */}
                {simGameMode === 'sepatu' && (
                  <div className="bg-white rounded-3xl p-6 sm:p-10 border-2 border-[#E9D8BD]/50 shadow-xl space-y-6">
                    <div className="flex items-center justify-between pb-4 border-b border-[#ECE3D4]">
                      <div>
                        <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wider">Level {simLevel} dari 7</span>
                        <h3 className="font-serif text-2xl font-bold text-[#173D2B]">
                          Workshop Sepatu Kulit: {sepatuDesign}
                        </h3>
                      </div>
                      <button onClick={() => setSimGameMode('menu')} className="text-xs text-gray-500 hover:underline">
                        Menu Game
                      </button>
                    </div>

                    {simLevel === 1 && (
                      <div className="space-y-6">
                        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
                          <div className="h-80 sm:h-96 w-full rounded-3xl overflow-hidden shadow-xl border-2 border-[#E9D8BD]">
                            <ThreeLeatherViewer craftType="sepatu" color={sepatuColor} modelType={sepatuDesign} />
                          </div>
                          <div className="space-y-4 text-xs">
                            <label className="font-bold block text-[#173D2B]">Pilih Model Sepatu:</label>
                            <div className="grid grid-cols-2 gap-2">
                              {['Sepatu Boots', 'Sepatu Oxford', 'Sepatu Pantofel', 'Ankle Boots'].map((s) => (
                                <button
                                  key={s}
                                  onClick={() => setSepatuDesign(s)}
                                  className={`p-2.5 rounded-xl border text-left font-bold ${sepatuDesign === s ? 'bg-[#8B4A2B] text-white' : 'bg-[#F8F4EC]'}`}
                                >
                                  {s}
                                </button>
                              ))}
                            </div>
                            <label className="font-bold block text-[#173D2B]">Bahan Kulit Sapi Sukaregang:</label>
                            <div className="flex gap-2">
                              {['Pull-Up Leather', 'Crazy Horse', 'Full-Grain'].map((m) => (
                                <button
                                  key={m}
                                  onClick={() => setSepatuLeather(m)}
                                  className={`px-3 py-1.5 rounded-xl border text-xs font-bold ${sepatuLeather === m ? 'bg-[#173D2B] text-white' : 'bg-white'}`}
                                >
                                  {m}
                                </button>
                              ))}
                            </div>
                          </div>
                        </div>

                        <button
                          onClick={() => setSimLevel(3)}
                          className="w-full py-3 bg-[#8B4A2B] text-white font-bold text-xs rounded-xl shadow"
                        >
                          Lanjut: Memotong Pola Vamp & Tongue →
                        </button>
                      </div>
                    )}

                    {simLevel === 3 && (
                      <div className="space-y-6 text-xs">
                        <h4 className="font-bold text-[#173D2B]">Potong 4 Pola Sepatu (Klik/Drag Gunting):</h4>
                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                          {[
                            { key: 'vamp', label: '1. Vamp (Muka Kaki)' },
                            { key: 'quarter', label: '2. Quarter (Samping)' },
                            { key: 'tongue', label: '3. Tongue (Lidah)' },
                            { key: 'heel', label: '4. Heel (Tumit)' },
                          ].map((p) => {
                            const done = sepatuCutParts[p.key];
                            return (
                              <button
                                key={p.key}
                                onClick={() => setSepatuCutParts(prev => ({ ...prev, [p.key]: true }))}
                                className={`p-5 rounded-2xl border text-center font-bold transition ${done ? 'bg-emerald-50 border-emerald-500 text-emerald-800' : 'bg-[#F8F4EC]'}`}
                              >
                                <span className="text-2xl block mb-1">{done ? '✓' : '✂️'}</span>
                                <span>{p.label}</span>
                              </button>
                            );
                          })}
                        </div>
                        <button
                          disabled={!Object.values(sepatuCutParts).every(Boolean)}
                          onClick={() => setSimLevel(5)}
                          className="w-full py-3 bg-[#173D2B] disabled:bg-gray-300 text-white font-bold rounded-xl shadow"
                        >
                          Lanjut: Pasang Sol Goodyear Welt →
                        </button>
                      </div>
                    )}

                    {simLevel === 5 && (
                      <div className="space-y-6 text-center text-xs">
                        <div className="p-6 bg-[#F8F4EC] rounded-2xl border max-w-md mx-auto space-y-3">
                          <span className="text-4xl block">🔨</span>
                          <h4 className="font-bold text-[#173D2B]">Memasang Outsole Sol Karet Sukaregang</h4>
                          <p className="text-gray-600">Tekan tombol di bawah untuk mengepres sol dengan jahitan keliling tembus:</p>
                          <button
                            onClick={() => {
                              setSoleAttached(true);
                              triggerEffect('Sol karet anti slip terpasang sempurna!');
                            }}
                            className={`w-full py-3 rounded-xl font-bold ${soleAttached ? 'bg-emerald-700 text-white' : 'bg-[#8B4A2B] text-white'}`}
                          >
                            {soleAttached ? '✓ Sol Terpasang Kuat' : '🔨 Pasang Sol Goodyear Welt'}
                          </button>
                        </div>
                        {soleAttached && (
                          <button
                            onClick={() => setSimLevel(7)}
                            className="px-6 py-3 bg-[#173D2B] text-white font-bold rounded-xl shadow"
                          >
                            Lihat Hasil Sepatu 3D →
                          </button>
                        )}
                      </div>
                    )}

                    {simLevel === 7 && (
                      <div className="space-y-6 text-center animate-fadeIn">
                        <h3 className="font-serif text-3xl font-bold text-[#173D2B]">
                          {sepatuDesign} Selesai Dibuat!
                        </h3>
                        <div className="h-80 sm:h-96 w-full max-w-xl mx-auto rounded-3xl overflow-hidden shadow-2xl border-2 border-[#E9D8BD]">
                          <ThreeLeatherViewer craftType="sepatu" color="#5a3319" modelType={sepatuDesign} />
                        </div>
                        <div className="p-5 bg-[#173D2B] text-white rounded-2xl max-w-md mx-auto text-xs">
                          <h4 className="font-serif font-bold text-sm text-[#E9D8BD]">SERTIFIKAT MASTER COBBLER GARUT</h4>
                          <p className="mt-1">Sepatu kulit asli berhasil diproduksi dengan konstruksi standar pabrik Sukaregang.</p>
                        </div>
                        <div className="flex justify-center gap-3">
                          <a href={SYAKIRA_OFFICIAL_SHOPEE_STORE} target="_blank" className="px-5 py-2.5 bg-[#8B4A2B] text-white font-bold text-xs rounded-xl">
                            Beli Sepatu di Shopee ↗
                          </a>
                          <button onClick={() => setSimGameMode('menu')} className="px-4 py-2.5 bg-gray-100 font-bold text-xs rounded-xl">
                            Pilih Permainan Lain
                          </button>
                        </div>
                      </div>
                    )}
                  </div>
                )}

              </div>
            )}

            {/* -------------------------------------------------------------
                EXPLORE PETA & KAWASAN PABRIK SUKAREGANG
            ------------------------------------------------------------- */}
            {currentRoute === 'explore' && (
              <div className="space-y-6 animate-fadeIn">
                <div className="bg-[#173D2B] rounded-3xl p-6 sm:p-10 text-[#F8F4EC] border-2 border-[#E9D8BD]/40 shadow-xl space-y-3">
                  <span className="text-xs uppercase font-bold tracking-widest text-[#E9D8BD]">Sentra Industri Kulit Garut</span>
                  <h2 className="font-serif text-3xl sm:text-4xl font-bold">PETA INTERAKTIF KAWASAN SUKAREGANG</h2>
                  <p className="text-xs sm:text-sm text-[#F8F4EC]/85 max-w-2xl leading-relaxed">
                    Kunjungi pabrik pembuatan jaket kulit, sentra penyamakan bahan kulit sapi, CV. Surya Wahana, Piazza Firenze, hingga gerai resmi Syakira Leather dengan link Google Maps terverifikasi.
                  </p>
                </div>

                <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                  <div className="space-y-3">
                    <h3 className="font-serif font-bold text-base text-[#173D2B]">Titik Kunjungan Terverifikasi:</h3>
                    <div className="space-y-3 max-h-[500px] overflow-y-auto custom-scroll pr-1">
                      {destinations.map((loc) => {
                        const isSelected = selectedMapLoc.id === loc.id;
                        return (
                          <div
                            key={loc.id}
                            onClick={() => setSelectedMapLoc(loc)}
                            className={`cursor-pointer p-4 rounded-2xl border-2 transition ${
                              isSelected ? 'bg-white border-[#8B4A2B] shadow-md' : 'bg-white/80 border-[#E9D8BD]/40 hover:bg-white'
                            }`}
                          >
                            <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wide">{loc.category}</span>
                            <h4 className="font-serif font-bold text-sm text-[#173D2B] mt-0.5">{loc.name}</h4>
                            <p className="text-[11px] text-[#35251D]/70 mt-1 line-clamp-2">{loc.address}</p>
                            <div className="mt-2.5 flex items-center justify-between">
                              <span className="text-[10px] text-[#173D2B] font-semibold">📍 Garut</span>
                              <a
                                href={loc.googleMapsUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                className="px-2.5 py-1 bg-[#173D2B] text-[#F8F4EC] text-[10px] font-bold rounded-lg hover:bg-[#102B1E] transition"
                                onClick={(e) => e.stopPropagation()}
                              >
                                Buka Maps ↗
                              </a>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  <div className="lg:col-span-2 space-y-4">
                    <div className="rounded-3xl overflow-hidden border-2 border-[#E9D8BD]/40 shadow-lg h-[400px] sm:h-[450px] relative z-10">
                      <div ref={mapContainerRef} className="w-full h-full"></div>
                    </div>

                    {selectedMapLoc && (
                      <div className="bg-white rounded-2xl p-4 border border-[#E9D8BD]/40 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div>
                          <span className="text-[10px] text-[#8B4A2B] font-bold uppercase">{selectedMapLoc.category}</span>
                          <h4 className="font-serif font-bold text-base text-[#173D2B]">{selectedMapLoc.name}</h4>
                          <p className="text-xs text-[#35251D]/75 mt-0.5">{selectedMapLoc.description}</p>
                        </div>
                        <a
                          href={selectedMapLoc.googleMapsUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="px-4 py-2.5 bg-[#8B4A2B] hover:bg-[#6E381F] text-white text-xs font-bold rounded-xl transition shadow flex-shrink-0 flex items-center space-x-1.5"
                        >
                          <Icon name="navigation" className="w-3.5 h-3.5" />
                          <span>Navigasi Google Maps ↗</span>
                        </a>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            )}

            {/* -------------------------------------------------------------
                SEJARAH & ENSIKLOPEDIA LENGKAP KULIT SUKAREGANG GARUT
            ------------------------------------------------------------- */}
            {currentRoute === 'sejarah' && (
              <div className="space-y-8 animate-fadeIn">
                {/* Header Banner Utama */}
                <div className="bg-[#173D2B] rounded-3xl p-6 sm:p-10 text-[#F8F4EC] border-2 border-[#E9D8BD]/40 shadow-xl space-y-3">
                  <span className="text-xs uppercase font-bold tracking-widest text-[#E9D8BD] flex items-center space-x-1.5">
                    <span>📚</span>
                    <span>Pusat Literasi & Edukasi Kulit Garut</span>
                  </span>
                  <h2 className="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold">
                    SEJARAH & ENSIKLOPEDIA KULIT SUKAREGANG
                  </h2>
                  <p className="text-xs sm:text-sm text-[#F8F4EC]/85 max-w-3xl leading-relaxed">
                    Eksplorasi lengkap perjalanan sejarah industri Sukaregang sejak era 1920-an, ragam jenis bahan kulit asli (Domba, Kambing, Sapi), kesesuaian produksi jaket & sepatu, panduan perawatan, serta cara akurat membedakan kulit asli dan tiruan.
                  </p>
                </div>

                {/* Sub-Navigasi Tab Edukasi Interaktif */}
                <div className="flex flex-wrap gap-2 p-1.5 bg-white rounded-2xl border border-[#E9D8BD] shadow-sm">
                  {[
                    { id: 'sejarah', label: '📜 Sejarah Sukaregang', icon: 'book-open' },
                    { id: 'jenis_kulit', label: '🐑 Jenis-Jenis Kulit', icon: 'layers' },
                    { id: 'produksi', label: '🧥👞 Produksi Jaket & Sepatu', icon: 'scissors' },
                    { id: 'perawatan', label: '✨ Cara Merawat Kulit', icon: 'sparkles' },
                    { id: 'asli_palsu', label: '🔍 Kulit Asli vs Palsu', icon: 'check-circle' },
                    { id: 'video', label: '🎥 Video Dokumenter', icon: 'video' },
                  ].map((tab) => (
                    <button
                      key={tab.id}
                      onClick={() => setSejarahActiveTab(tab.id)}
                      className={`px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center space-x-1.5 ${
                        sejarahActiveTab === tab.id
                          ? 'bg-[#173D2B] text-white shadow-md'
                          : 'text-[#35251D]/80 hover:bg-[#F8F4EC] hover:text-[#173D2B]'
                      }`}
                    >
                      <span>{tab.label}</span>
                    </button>
                  ))}
                </div>

                {/* =============================================================
                    TAB 1: SEJARAH LENGKAP KAWASAN INDUSTRI SUKAREGANG GARUT
                ============================================================= */}
                {sejarahActiveTab === 'sejarah' && (
                  <div className="space-y-6 animate-fadeIn">
                    <div className="bg-white rounded-3xl p-6 sm:p-10 border-2 border-[#E9D8BD]/50 shadow-md space-y-6">
                      <div className="border-b border-[#ECE3D4] pb-4">
                        <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wider">Bab 1 • Kronik Sejarah</span>
                        <h3 className="font-serif text-2xl sm:text-3xl font-bold text-[#173D2B] mt-1">
                          Perjalanan Seabad Kawasan Industri Kulit Sukaregang (1920 - Sekarang)
                        </h3>
                        <p className="text-xs text-gray-600 mt-1">
                          Dari bantaran Sungai Cimanuk hingga menembus panggung fesyen internasional.
                        </p>
                      </div>

                      <div className="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-[#35251D]/85 leading-relaxed">
                        <div className="p-5 rounded-2xl bg-[#F8F4EC] border border-[#E9D8BD] space-y-2">
                          <span className="px-2.5 py-1 bg-[#173D2B] text-[#E9D8BD] rounded-lg font-bold text-[10px] uppercase">
                            Era 1920 - 1945 • Awal Mula Tradisi
                          </span>
                          <h4 className="font-serif font-bold text-sm text-[#173D2B]">Penyamakan Nabati Tradisional Hindia Belanda</h4>
                          <p>
                            Tradisi pengolahan kulit di Sukaregang berakar sejak dekade 1920-an pada masa kolonial Belanda. Keberadaan aliran Sungai Cimanuk yang melintasi kawasan ini menjadi urat nadi utama untuk pencucian kulit mentah.
                          </p>
                          <p>
                            Pengrajin awal menggunakan penyamak nabati alami dari kulit pohon mahoni dan getah akasia (<em>vegetable tanning</em>). Hasil olahan pada masa itu berupa tali pelana kuda kavaleri, sabuk lumbung padi, dan sarung golok khas Sunda.
                          </p>
                        </div>

                        <div className="p-5 rounded-2xl bg-[#F8F4EC] border border-[#E9D8BD] space-y-2">
                          <span className="px-2.5 py-1 bg-[#8B4A2B] text-white rounded-lg font-bold text-[10px] uppercase">
                            Era 1950 - 1970 • Modernisasi & Koperasi
                          </span>
                          <h4 className="font-serif font-bold text-sm text-[#173D2B]">Kelahiran Sentra Pengrajin Jaket Kulit</h4>
                          <p>
                            Pasca-kemerdekaan RI, para perintis industri kulit Garut membentuk paguyuban koperasi. Pada era 1960-an, teknologi penyamakan mineral krom diperkenalkan, menghasilkan lembaran kulit domba yang sangat lembut, fleksibel, dan elastis.
                          </p>
                          <p>
                            Pengrajin Garut mulai memproduksi jaket kulit untuk pilot TNI Angkatan Udara dan jaket kasual, yang seketika diminati pasar Jakarta dan kota-kota besar nasional.
                          </p>
                        </div>

                        <div className="p-5 rounded-2xl bg-[#F8F4EC] border border-[#E9D8BD] space-y-2">
                          <span className="px-2.5 py-1 bg-[#173D2B] text-[#E9D8BD] rounded-lg font-bold text-[10px] uppercase">
                            Era 1980 - 1990 • Puncak Kejayaan Dunia
                          </span>
                          <h4 className="font-serif font-bold text-sm text-[#173D2B]">Pengakuan Ekspor & Standar Asia Tenggara</h4>
                          <p>
                            Sukaregang dinobatkan sebagai sentra kerajinan kulit terbaik di Asia Tenggara. Kualitas kulit domba Garut diakui memiliki kelembutan kelas dunia, bersaing langsung dengan produk kulit Italia dan Turki.
                          </p>
                          <p>
                            Ribuan potong jaket kulit Sukaregang diekspor secara rutin ke Jerman, Korea Selatan, Jepang, dan Amerika Serikat. Garut pun dijuluki "Kota Kulit & Kota Intan".
                          </p>
                        </div>

                        <div className="p-5 rounded-2xl bg-[#F8F4EC] border border-[#E9D8BD] space-y-2">
                          <span className="px-2.5 py-1 bg-emerald-800 text-white rounded-lg font-bold text-[10px] uppercase">
                            Era 2000 - Sekarang • Wisata Belanja & IPAL
                          </span>
                          <h4 className="font-serif font-bold text-sm text-[#173D2B]">Sentra Wisata Digital Terpadu</h4>
                          <p>
                            Kini sepanjang Jalan Gagak Lumayung Sukaregang bertransformasi menjadi surga belanja terpadu. Ratusan galeri resmi seperti <strong>Syakira Leather</strong> berdiri berdampingan dengan workshop pengrajin.
                          </p>
                          <p>
                            Industri Sukaregang terus berkembang ramah lingkungan melalui Instalasi Pengolahan Air Limbah (IPAL) terpusat, menjaga kelestarian alam Garut sekaligus memajukan ekonomi lokal.
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {/* =============================================================
                    TAB 2: JENIS-JENIS KULIT (DOMBA, KAMBING, SAPI)
                ============================================================= */}
                {sejarahActiveTab === 'jenis_kulit' && (
                  <div className="space-y-6 animate-fadeIn">
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                      {/* 1. Kulit Domba Garut */}
                      <div className="bg-white rounded-3xl p-6 border-2 border-[#E9D8BD]/60 shadow-md flex flex-col justify-between space-y-4">
                        <div className="space-y-3">
                          <div className="w-12 h-12 rounded-2xl bg-amber-100 flex items-center justify-center text-2xl shadow">
                            🐑
                          </div>
                          <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wider">Primadona Garut</span>
                          <h4 className="font-serif font-bold text-lg text-[#173D2B]">Kulit Domba Garut (Sheepskin)</h4>
                          <ul className="text-xs text-gray-700 space-y-2 list-disc list-inside">
                            <li><strong>Pori Mikro:</strong> Pori-pori sangat halus, padat, dan seragam alami.</li>
                            <li><strong>Super Lembut (Supple):</strong> Terasa sehalus sutra, lentur, dan tidak kaku saat dipakai.</li>
                            <li><strong>Ringan & Fleksibel:</strong> Bobot paling enteng sehingga nyaman dipakai seharian tanpa pegal.</li>
                            <li><strong>Kemampuan Termal:</strong> Menyejukkan di terik siang hari, namun menghangatkan di udara dingin.</li>
                            <li><strong>Grade A Super:</strong> Standar emas ekspor Sukaregang dengan ketebalan 0.6 - 0.8 mm.</li>
                          </ul>
                        </div>
                        <div className="p-3 bg-amber-50 rounded-xl text-[11px] text-amber-900 font-semibold border border-amber-200">
                          🎯 Paling Cocok: <strong>Jaket Fesyen, Sarung Tangan, Tas Wanita, & Dompet Halus</strong>.
                        </div>
                      </div>

                      {/* 2. Kulit Kambing */}
                      <div className="bg-white rounded-3xl p-6 border-2 border-[#E9D8BD]/60 shadow-md flex flex-col justify-between space-y-4">
                        <div className="space-y-3">
                          <div className="w-12 h-12 rounded-2xl bg-emerald-100 flex items-center justify-center text-2xl shadow">
                            🐐
                          </div>
                          <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wider">Ulet & Kuat</span>
                          <h4 className="font-serif font-bold text-lg text-[#173D2B]">Kulit Kambing (Goatskin)</h4>
                          <ul className="text-xs text-gray-700 space-y-2 list-disc list-inside">
                            <li><strong>Pebble Grain:</strong> Memiliki pola kerutan alami yang khas dan berkarakter unik.</li>
                            <li><strong>Serat Sangat Ulet:</strong> Seratnya liat dan padat, menjadikannya sangat sulit robek.</li>
                            <li><strong>Tahan Gesekan:</strong> Memiliki ketahanan abrasi alami yang lebih tinggi dibanding domba.</li>
                            <li><strong>Kandungan Lanolin Alami:</strong> Lebih tahan terhadap kelembapan dan cipratan air.</li>
                            <li><strong>Bobot Sedang:</strong> Lebih kokoh namun tetap elastis mengikuti lekuk jahitan.</li>
                          </ul>
                        </div>
                        <div className="p-3 bg-emerald-50 rounded-xl text-[11px] text-emerald-900 font-semibold border border-emerald-200">
                          🎯 Paling Cocok: <strong>Insole Sepatu, Jaket Militer, Tas Kerja, & Ikat Pinggang</strong>.
                        </div>
                      </div>

                      {/* 3. Kulit Sapi */}
                      <div className="bg-white rounded-3xl p-6 border-2 border-[#E9D8BD]/60 shadow-md flex flex-col justify-between space-y-4">
                        <div className="space-y-3">
                          <div className="w-12 h-12 rounded-2xl bg-blue-100 flex items-center justify-center text-2xl shadow">
                            🐂
                          </div>
                          <span className="text-[10px] font-bold text-[#8B4A2B] uppercase tracking-wider">Tebal & Kokoh</span>
                          <h4 className="font-serif font-bold text-lg text-[#173D2B]">Kulit Sapi (Cowhide)</h4>
                          <ul className="text-xs text-gray-700 space-y-2 list-disc list-inside">
                            <li><strong>Tebal & Mantap:</strong> Ketebalan 1.2 mm - 2.2 mm, sangat kokoh dan berbobot.</li>
                            <li><strong>Daya Tahan Puluhan Tahun:</strong> Mampu bertahan dari benturan keras, aspal, dan cuaca ekstrem.</li>
                            <li><strong>Varian Pull-Up:</strong> Diimpregnasi minyak alami; memunculkan gradasi antik saat ditekuk.</li>
                            <li><strong>Crazy Horse Leather:</strong> Lapisan lilin khusus menghasilkan goresan artistik khas vintage.</li>
                            <li><strong>Full Grain:</strong> Lapisan kulit teratas paling alami tanpa modifikasi.</li>
                          </ul>
                        </div>
                        <div className="p-3 bg-blue-50 rounded-xl text-[11px] text-blue-900 font-semibold border border-blue-200">
                          🎯 Paling Cocok: <strong>Sepatu Boots, Pantofel Pria, Sol Luar, Sabuk Tebal, & Jaket Biker</strong>.
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {/* =============================================================
                    TAB 3: KESESUAIAN PRODUKSI (JAKET VS SEPATU)
                ============================================================= */}
                {sejarahActiveTab === 'produksi' && (
