                      <div className="space-y-4 text-xs">
                        {[
                          {
                            no: '1',
                            title: 'Uji Aroma / Bau (The Scent Test)',
                            icon: '👃',
                            asli: 'Memiliki aroma hewani alami yang sangat khas, mewah, dan tidak pernah hilang meski sudah bertahun-tahun.',
                            palsu: 'Berbau tajam bahan kimia sintetis, pelarut pabrik, plastik baru, atau karet menyengat.',
                          },
                          {
                            no: '2',
                            title: 'Uji Pori-Pori & Tekstur Permukaan (The Grain Test)',
                            icon: '🔬',
                            asli: 'Pori-pori bervariasi dengan ketidakteraturan alami yang membuktikan berasal dari kulit hewan alami.',
                            palsu: 'Pola bintik atau kerutan tercetak sangat simetris dan berulang secara geometris karena hasil cetakan rol mesin.',
                          },
                          {
                            no: '3',
                            title: 'Uji Tekukan & Elastisitas (The Bend Test)',
                            icon: '🖐️',
                            asli: 'Saat ditekuk atau ditekan dengan jari, muncul kerutan-kerutan halus alami dan warnanya sedikit merekah lalu kembali rata.',
                            palsu: 'Terasa kaku, membal seperti spons plastik, atau menimbulkan lipatan patah permanen yang tidak pulih.',
                          },
                          {
                            no: '4',
                            title: 'Uji Tetesan Air (The Water Drop Test)',
                            icon: '💧',
                            asli: 'Teteskan setitik air kecil; dalam 1-2 menit air akan terserap secara perlahan oleh pori-pori bernapas kulit asli.',
                            palsu: 'Air tidak terserap sama sekali, hanya menggenang bulat di permukaan dan langsung tergelincir jatuh seperti di atas plastik.',
                          },
                          {
                            no: '5',
                            title: 'Uji Tahan Panas / Api (The Flame Resistance Test)',
                            icon: '🔥',
                            asli: 'Tahan percikan api korek sesaat; tidak meleleh, hanya sedikit hangus dengan aroma khas rambut terbakar.',
                            palsu: 'Langsung meleleh, mengerut, terbakar dalam hitungan detik, dan mengeluarkan asap hitam pekat beracun.',
                          },
                          {
                            no: '6',
                            title: 'Uji Sentuhan Suhu Tubuh (The Thermal Test)',
                            icon: '🌡️',
                            asli: 'Terasa hangat saat disentuh telapak tangan karena kulit alami mampu mengalirkan kehangatan suhu tubuh.',
                            palsu: 'Terasa dingin dan licin lengket plastik saat pertama kali disentuh tangan.',
                          },
                        ].map((test) => (
