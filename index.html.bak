  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap');
    
    html {
      scroll-behavior: smooth;
      background-color: #F8F4EC;
      color: #35251D;
      -webkit-tap-highlight-color: transparent;
    }
    
    .app-glass {
      background: rgba(23, 61, 43, 0.96);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #F8F4EC;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #E9D8BD;
      border-radius: 4px;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 15px rgba(233, 216, 189, 0.4); }
      50% { box-shadow: 0 0 30px rgba(139, 74, 43, 0.7); }
    }
    .glow-leather {
      animation: pulseGlow 3s infinite;
    }

    /* 3D Canvas Container */
    .canvas-3d-box {
      touch-action: none;
      cursor: grab;
    }
    .canvas-3d-box:active {
      cursor: grabbing;
    }
  </style>
</head>
